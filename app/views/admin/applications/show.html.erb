<% content_for :title, "#{@character.name} · Applications · Admin · Inkwll" %>

<p class="breadcrumbs"><%= link_to "Applications", admin_applications_path %></p>
<h1 class="character-heading"><%= character_icon(@character, size: :large) %> <%= @character.name %></h1>
<p class="muted">Played by <%= @character.account.display_name %>. <%= @character.status.humanize %><%= ", submitted #{time_ago_in_words(@character.submitted_at)} ago" if @character.submitted_at %>.</p>

<%# Everything a reviewer may need, as tabs: the answers, then the SOUL sheet,
    Grimoire, gallery and relationships, all read-only here. %>
<nav class="profile-tabs application-tabs" aria-label="Application sections">
  <% @tabs.each do |tab, label| %>
    <%= link_to label, admin_application_path(@character, tab: tab), class: "profile-tabs__tab application-tabs__tab#{" profile-tabs__tab--current" if @tab == tab}",
          aria: { current: (@tab == tab ? "page" : nil) } %>
  <% end %>
</nav>

<section class="application-panel application-panel--<%= @tab %>">
  <% if @tab == "answers" %>
    <% extra = capture do %>
      <% if (age = @character.age) %>
        <div class="profile-fields__row"><dt class="details-list__term">Age</dt><dd class="details-list__value"><%= age %></dd></div>
      <% end %>
    <% end %>
    <h2 class="section-title">Demographics</h2>
    <%= render "characters/profile_fields", character: @character, section: "demographics", show_private: true, extra: extra %>
    <h2 class="section-title">Application</h2>
    <%= render "characters/profile_fields", character: @character, section: "application", show_private: true %>
  <% else %>
    <%= render "characters/tabs/#{@tab}", character: @character, show_private: true %>
  <% end %>
</section>

<% if @character.submitted? %>
  <section class="application-review">
    <h2 class="section-title">Decision</h2>
    <% if Faction.enabled? %>
      <p class="text application-review__factions"><%= term(:faction, count: 2) %> picked: <%= safe_join(@character.factions.ordered.map { |faction| link_to(faction.name, faction_path(faction)) }, ", ").presence || "none" %></p>
    <% end %>
    <%= form_with url: admin_application_path(@character), method: :patch, class: "form form--inline application-review__approve" do |form| %>
      <%= hidden_field_tag :decision, "approve" %>
      <% if @character.character_group_id.nil? && (groups = CharacterGroup.ordered).any? %>
        <%= form.label :character_group_id, "Add to a group", class: "application-review__group-label" %>
        <%= form.select :character_group_id, groups.map { |group| [ group.name, group.id ] }, include_blank: "No group" %>
      <% end %>
      <%= form.submit "Approve", class: "button" %>
    <% end %>
    <%= form_with url: admin_application_path(@character), method: :patch, class: "form application-review__return" do |form| %>
      <%= hidden_field_tag :decision, "return" %>
      <div class="field">
        <%= form.label :note, "Or return it to the player, saying what to change" %>
        <%= form.text_area :note, rows: 4, required: true %>
      </div>
      <%= form.submit "Return to player", class: "button button--quiet" %>
    <% end %>
  </section>
<% end %>
