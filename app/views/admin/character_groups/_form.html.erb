<%= form_with model: [ :admin, group ], class: "form character-group-form" do |form| %>
  <%= render "shared/errors", record: group %>
  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 60 %>
  </div>
  <div class="field">
    <%= form.label :colour, "Name colour" %>
    <%= form.color_field :colour %>
  </div>
  <div class="field">
    <%= form.label :description, "Description (optional)" %>
    <%= form.text_field :description, maxlength: 300 %>
  </div>
  <div class="field field--checkbox character-group-form__wanted">
    <%= form.check_box :needs_players %>
    <%= form.label :needs_players, "This group needs players" %>
  </div>
  <div class="field">
    <%= form.label :wanted_note, "What it needs (optional)" %>
    <%= form.text_field :wanted_note, maxlength: 200, placeholder: "A healer, and someone to lead the night watch" %>
    <small class="hint">Shown in the census at the top of the Character Directory, so new players can see where they're needed.</small>
  </div>
  <% if group.persisted? %>
    <div class="field">
      <%= form.label :position, "Order (lower comes first)" %>
      <%= form.number_field :position %>
    </div>
  <% end %>
  <%= form.submit class: "button" %>
<% end %>
