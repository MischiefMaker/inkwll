<% content_for :title, "Wells · Admin · Inkwll" %>
<% if @updates.any? { |update| update.running? || update.status == "waiting_turn" } %>
  <% content_for :head do %><meta http-equiv="refresh" content="15"><% end %>
<% end %>

<h1 class="page-title">Wells</h1>
<% if @home_url %>
  <p class="text wells__home">This Well runs <strong><%= inkwll_version_name || "an unknown version" %></strong>. Its updates are done from <%= link_to "#{@home_url}/admin/wells", "#{@home_url}/admin/wells" %>.</p>
<% else %>
<p class="muted">Only the <%= term(:founder) %> sees this page. Each Well is its own game with its own database. Updates are done by GitHub, and only versions Claude has marked ready can be installed. A database backup is made before every update.</p>

<% busy = @updates.any? { |update| update.running? || update.status == "waiting_turn" } %>
<% @updates.select { |update| update.running? || update.status == "waiting_turn" }.reverse_each do |update| %>
  <p class="flash flash--notice wells__busy"><strong><%= update.first_time ? "Starting #{(update.well&.name || game_name)} at #{update.version}" : "Updating #{(update.well&.name || game_name)} to #{update.version}" %>: <%= update.state_label.downcase %>.</strong>
    <%= update.state_label == "Waiting to start" ? "GitHub starts it as soon as any other deploy has finished." : "It takes a few minutes." %> This page checks every 15 seconds, so there's nothing to do but wait.<% if update.run_url.present? %> <%= link_to "See the log", update.run_url, target: "_blank", rel: "noopener" %><% end %></p>
<% end %>
<table class="table wells__list">
  <thead class="table__head"><tr class="table__row"><th class="table__heading">Well</th><th class="table__heading">Address</th><th class="table__heading">Version</th><th class="table__heading"></th></tr></thead>
  <tbody class="table__body">
    <tr class="table__row wells__well">
      <td class="table__cell"><%= game_name %> <span class="muted">(this one)</span></td>
      <td class="table__cell"><%= ENV.fetch("APP_HOST", request.host) %></td>
      <td class="table__cell wells__version"><%= inkwll_version_name || "Unknown" %></td>
      <td class="table__cell muted">Update it under Versions below.</td>
    </tr>
    <% @wells.each do |well| %>
      <tr class="table__row wells__well wells__well--<%= well.status %>">
        <td class="table__cell"><%= well.name %></td>
        <td class="table__cell"><%= link_to well.domain, "https://#{well.domain}", target: "_blank", rel: "noopener" %></td>
        <td class="table__cell wells__version"><%= { "starting" => "Starting…", "failed" => "Didn't start" }.fetch(well.status, well.version) %></td>
        <td class="table__cell">
          <% if @releases.any? && !busy && (well.version != @releases.first.tag || well.status == "failed") %>
            <%= button_to (well.status == "failed" ? "Try again" : "Update to #{@releases.first.tag}"), admin_well_updates_path, params: { version: @releases.first.tag, well_id: well.id }, class: "button wells__install",
                  form: { data: { turbo_confirm: "Update #{well.name} to #{@releases.first.tag}? A database backup is made first." } } %>
          <% end %>
        </td>
      </tr>
      <% if well.status == "live" %>
        <tr class="table__row wells__setup-link">
          <td class="table__cell muted" colspan="4">First sign-up link for <%= well.name %> (that player becomes its <%= term(:founder) %>; it stops working once it has one): <code><%= well.setup_url %></code></td>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>

<h2 class="section-title">Versions</h2>
<p class="text wells__current">You are currently running <strong><%= inkwll_version_name || "an unknown version" %></strong>.</p>
<% if !@configured %>
  <div class="wells__setup">
    <p class="text">Updates need a GitHub key first. It can only start the Deploy workflow and read the code, nothing else.</p>
    <ol class="wells__steps">
      <li>On GitHub, open Settings → Developer settings → Personal access tokens → Fine-grained tokens → Generate new token.</li>
      <li>Name it "Inkwll Wells", set it to expire in a year, and under Repository access pick Only select repositories and choose the inkwll repository.</li>
      <li>Under Permissions, set Actions to Read and write and Contents to Read-only. Leave everything else as No access.</li>
      <li>Copy the token. In the inkwll repository, open Settings → Secrets and variables → Actions → New repository secret, name it <code>WELLS_GITHUB_TOKEN</code> and paste it in.</li>
      <li>The next deploy hands it to the game, and this page lists the versions.</li>
    </ol>
  </div>
<% elsif @github_error %>
  <p class="flash flash--alert wells__error"><%= @github_error %></p>
<% elsif @releases.empty? %>
  <p class="muted">No versions are marked ready yet.</p>
<% else %>
  <% newest = @releases.first %>
  <%# Only the newest version gets a button; older ones are folded away as notes. To go back, ask Claude. %>
  <div class="wells__release wells__release--newest<%= " wells__release--current" if newest.tag == @current_version %>">
    <h3 class="wells__release-name">Newest: <%= newest.name %> <span class="muted">· <%= newest.published_at&.to_date&.to_fs(:long) %></span></h3>
    <% if newest.notes.present? %><div class="wells__release-notes"><%= simple_format(newest.notes) %></div><% end %>
    <% if newest.tag == @current_version %>
      <p class="wells__release-current">Running now. You're up to date.</p>
    <% elsif !busy %>
      <%= button_to "Update to #{newest.tag}", admin_well_updates_path, params: { version: newest.tag }, class: "button wells__install",
            form: { data: { turbo_confirm: "Update the live game to #{newest.tag}? A database backup is made first." } } %>
    <% end %>
    <% if @wells.any? { |well| well.status == "live" } && !busy %>
      <%= button_to "Update every Well to #{newest.tag}", admin_well_updates_path, params: { version: newest.tag, all: "1" }, class: "button wells__install-all",
            form: { data: { turbo_confirm: "Update this game and every other Well to #{newest.tag}, one after another? Keep the page open while it runs." } } %>
    <% end %>
  </div>
  <% older = @releases.drop(1) %>
  <% if older.any? %>
    <details class="wells__older">
      <summary class="wells__older-summary">Older versions</summary>
      <ul class="wells__releases">
        <% older.each do |release| %>
          <li class="wells__release<%= " wells__release--current" if release.tag == @current_version %>">
            <h3 class="wells__release-name"><%= release.name %> <span class="muted">· <%= release.published_at&.to_date&.to_fs(:long) %></span></h3>
            <% if release.notes.present? %><div class="wells__release-notes"><%= simple_format(release.notes) %></div><% end %>
            <% if release.tag == @current_version %>
              <p class="wells__release-current">Running now.</p>
            <% end %>
          </li>
        <% end %>
      </ul>
    </details>
  <% end %>
<% end %>

<% if @updates.any? %>
  <h2 class="section-title">Recent updates</h2>
  <table class="table wells__updates">
    <thead class="table__head"><tr class="table__row"><th class="table__heading">Well</th><th class="table__heading">Version</th><th class="table__heading">Started</th><th class="table__heading">By</th><th class="table__heading">How it went</th></tr></thead>
    <tbody class="table__body">
      <% @updates.each do |update| %>
        <tr class="table__row wells__update wells__update--<%= update.state_kind %>">
          <td class="table__cell"><%= (update.well&.name || game_name) %></td>
          <td class="table__cell"><%= update.first_time ? "Start at #{update.version}" : update.version %></td>
          <td class="table__cell"><%= update.created_at.to_fs(:short) %></td>
          <td class="table__cell"><%= update.account.display_name %></td>
          <td class="table__cell"><%= update.state_label %><% if update.run_url.present? %> · <%= link_to "Log", update.run_url, target: "_blank", rel: "noopener" %><% end %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @configured && !@github_error %>
  <h2 class="section-title">Start a new Well</h2>
  <% newest = @releases.first %>
  <% if newest.nil? %>
    <p class="muted">A version has to be marked ready first.</p>
  <% elsif busy %>
    <p class="muted">Wait for the running update to finish first.</p>
  <% else %>
    <p class="muted">A new game on this droplet, with its own database, at its own address under <%= @base_domain %>. It starts with <%= newest.tag %> and the starter map. This droplet has 1 GB of memory, which is probably enough for two small Wells; more need a bigger droplet.</p>
    <%= form_with model: @well, url: admin_wells_path, method: :post, class: "form wells__new" do |form| %>
      <%= render "shared/errors", record: @well %>
      <div class="field">
        <%= form.label :name, "The Well's name" %>
        <%= form.text_field :name, maxlength: 60, required: true %>
      </div>
      <div class="field">
        <%= form.label :slug, "Its address" %>
        <span class="wells__address"><%= form.text_field :slug, maxlength: 20, required: true, pattern: "[a-z][a-z0-9]{1,19}", class: "wells__slug" %>.<%= @base_domain %></span>
        <p class="muted field__hint">Small letters and numbers only, like moonfall.</p>
      </div>
      <div class="field">
        <%= label_tag :confirm_name, "Type the name again to confirm" %>
        <%= text_field_tag :confirm_name, nil, required: true, autocomplete: "off" %>
      </div>
      <%= form.submit "Start this Well", class: "button wells__start" %>
    <% end %>
  <% end %>
<% end %>
<% end %>
