<% content_for :title, "New ban · Admin · Inkwll" %>

<h1>New ban</h1>
<p class="muted">Ban a player, an IP address, or both. Their open sessions end straight away.</p>

<%= form_with model: @ban, url: admin_bans_path, class: "form" do |form| %>
  <%= render "shared/errors", record: @ban %>
  <div class="field">
    <%= form.label :player_name, "Player name (optional)" %>
    <%= form.text_field :player_name, value: @ban.account&.display_name %>
  </div>
  <div class="field">
    <%= form.label :ip_range, "IP address or range (optional)" %>
    <%= form.text_field :ip_range, placeholder: "203.0.113.7 or 203.0.113.0/24" %>
    <small>A player's recent addresses are on their page under Players and staff.</small>
  </div>
  <div class="field">
    <%= form.label :reason %>
    <%= form.text_area :reason, rows: 3, required: true %>
  </div>
  <div class="field">
    <%= form.label :expires_on, "Ends on (leave empty for permanent)" %>
    <%= form.date_field :expires_on %>
  </div>
  <%= form.submit "Ban", class: "button" %>
<% end %>
