<% content_for :title, "Roster · Admin · Inkwll" %>

<div class="roster-admin">
  <h1 class="page-title">Roster</h1>

  <h2 class="section-title">Applications</h2>
  <% if @applications.any? %>
    <ul class="roster-admin__list">
      <% @applications.each do |application| %>
        <li class="roster-admin__item roster-admin__item--application">
          <p class="text"><%= link_to application.account.display_name, player_path(application.account.username) %> wants to play
            <%= link_to application.character.name, character_path(application.character) %>
            <span class="muted">(<%= time_ago_in_words(application.created_at) %> ago)</span></p>
          <% if application.answers.any? %>
            <dl class="roster-admin__answers">
              <% RosterApplication.questions.each do |field| %>
                <% next unless (answer = application.answers[field.id.to_s]) %>
                <dt class="roster-admin__question"><%= field.name %></dt>
                <dd class="prose roster-admin__answer"><%= simple_format answer %></dd>
              <% end %>
            </dl>
          <% end %>
          <div class="prose roster-admin__note"><%= simple_format application.note %></div>
          <div class="roster-admin__actions">
            <%= button_to "Approve", admin_roster_application_path(application), method: :patch, params: { decision: "approve" }, class: "button",
                  form: { data: { turbo_confirm: "Give #{application.character.name} to #{application.account.display_name}? Anyone else who applied is turned down." } } %>
            <%= form_with url: admin_roster_application_path(application), method: :patch, class: "form form--inline roster-admin__deny" do |form| %>
              <%= hidden_field_tag :decision, "deny" %>
              <%= form.label :reason, "Reason", class: "visually-hidden" %>
              <%= form.text_field :reason, placeholder: "Why not (the player sees this)", maxlength: 250 %>
              <%= form.submit "Turn down", class: "button button--quiet" %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text muted">Nothing waiting.</p>
  <% end %>

  <h2 class="section-title">Players giving up a character</h2>
  <% if @requests.any? %>
    <ul class="roster-admin__list">
      <% @requests.each do |character| %>
        <li class="roster-admin__item roster-admin__item--request">
          <p class="text"><%= link_to character.account.display_name, player_path(character.account.username) %> asks to put
            <%= link_to character.name, character_path(character) %> on the roster.</p>
          <div class="roster-admin__actions">
            <%= form_with url: admin_roster_character_path(character), method: :patch, class: "form form--inline roster-admin__put-on" do |form| %>
              <%= form.label :roster_note, "Note for applicants", class: "visually-hidden" %>
              <%= form.text_field :roster_note, placeholder: "Note for applicants (optional)", maxlength: 2_000 %>
              <%= form.submit "Put on the roster", class: "button" %>
            <% end %>
            <%= button_to "Decline", admin_roster_character_path(character), method: :patch, params: { decision: "decline" }, class: "button button--quiet" %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text muted">Nothing waiting.</p>
  <% end %>

  <h2 class="section-title">Being prepared</h2>
  <% if @preparing.any? %>
    <ul class="roster-admin__list">
      <% @preparing.each do |character| %>
        <li class="roster-admin__item roster-admin__item--preparing">
          <%= link_to character.name, character_path(character) %>
          <span class="muted">only staff can see them yet</span>
          <%= link_to "Edit", edit_character_path(character), class: "button button--quiet roster-admin__edit" %>
          <%= button_to "Open on the roster", admin_roster_character_path(character), method: :patch, params: { decision: "open" }, class: "button",
                form: { data: { turbo_confirm: "Open #{character.name} on the roster? Players will be able to see and apply for them." } } %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text muted">Nobody is being prepared.</p>
  <% end %>

  <h2 class="section-title">On the roster now</h2>
  <% if @roster.any? %>
    <ul class="roster-admin__list">
      <% @roster.each do |character| %>
        <li class="roster-admin__item roster-admin__item--character">
          <%= link_to character.name, character_path(character) %>
          <%= link_to "Edit", edit_character_path(character), class: "button button--quiet roster-admin__edit" %>
          <span class="muted">since <%= character.on_roster_at.to_date.to_fs(:long) %>,
            <%= pluralize(character.roster_applications.count(&:pending?), "application") %> waiting</span>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text muted">Nobody is on the roster.</p>
  <% end %>
  <p class="text muted">To put a character who's being played on the roster, use "Put on the roster" in the
    <%= link_to "Characters", admin_characters_path %> list<%= " (Wellkeepers only)" unless current_account.can?(:delete_characters) %>.</p>

  <h2 class="section-title">Add a character to the roster</h2>
  <p class="text muted">A character nobody has played yet, such as one from the story or a "wanted" ad. Adding them takes you to their
    profile to fill in the rest (profile, SOUL, background). Players can't see them until you open them on the roster.</p>
  <%= form_with scope: :character, url: admin_roster_characters_path, class: "form roster-admin__new" do |form| %>
    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, maxlength: 60 %>
    </div>
    <div class="field">
      <%= form.label :roster_note, "Note for applicants" %>
      <%= form.text_area :roster_note, rows: 3, maxlength: 2_000 %>
      <small class="hint">Shown on the character's page, for example what kind of player you're looking for.</small>
    </div>
    <%= form.submit "Add and fill in", class: "button" %>
  <% end %>
</div>
