<%= form_with model: [ :admin, board ], class: "form forum-board-form" do |form| %>
  <%= render "shared/errors", record: board %>
  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 80 %>
  </div>
  <div class="field">
    <%= form.label :description, "Description (optional)" %>
    <%= form.text_area :description, rows: 2, maxlength: 1_000 %>
    <small class="hint">Shown under the <%= term(:forum_board).downcase %>'s name on the front page.</small>
  </div>
  <div class="field">
    <%= form.label :who_can_start, "Who can start #{term(:forum_topic, count: 2).downcase}" %>
    <%= form.select :who_can_start, forum_poster_options(ForumBoard::STARTERS) %>
  </div>
  <div class="field">
    <%= form.label :who_can_reply, "Who can reply" %>
    <%= form.select :who_can_reply, forum_poster_options(ForumBoard::POSTERS) %>
    <small class="hint">Scribes and Wellkeepers can always pin, lock and delete <%= term(:forum_topic, count: 2).downcase %>, and reply in locked ones.</small>
  </div>
  <div class="field field--checkbox forum-board-form__in-character">
    <%= form.check_box :in_character %>
    <%= form.label :in_character, "In character: people post as one of their characters, not under their player name" %>
  </div>
  <% if board.persisted? %>
    <div class="field">
      <%= form.label :position, "Order (lower comes first)" %>
      <%= form.number_field :position %>
    </div>
  <% end %>
  <%= render "shared/image_field", form: form, record: board, picture: :icon, label: "Small icon",
        hint: "Shown beside the #{term(:forum_board).downcase}'s name." %>
  <%= render "shared/image_field", form: form, record: board, picture: :image, label: "Large banner",
        hint: "Shown across the top of its card on the front page." %>
  <%= form.submit board.persisted? ? "Save" : "Add #{term(:forum_board).downcase}", class: "button" %>
<% end %>
