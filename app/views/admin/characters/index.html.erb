<% content_for :title, "Characters · Inkwll" %>

<h1 class="page-title">Characters</h1>
<p class="text muted">Characters are never deleted. Retiring one stops it being played and takes it off the Where list and out of <%= term(:room, count: 2) %>; its <%= term(:pose, count: 2).downcase %> and <%= term(:log, count: 2).downcase %> stay, greyed out.</p>

<% roster, others = @characters.partition { |character| character.on_roster? || character.preparing_for_roster? } %>
<% retired, active = others.partition(&:retired?) %>
<% approved, new_ones = active.partition(&:approved?) %>
<%# Each section folds away with its heading. %>
<% [ [ "approved", "Approved", approved ], [ "new", "New", new_ones ], [ "roster", "Roster characters", roster ], [ "retired", "Retired characters", retired ] ].each do |key, title, list| %>
  <% next if list.empty? && key != "approved" %>
  <details class="admin-characters__section admin-characters__<%= key == "approved" ? "active admin-characters__approved" : key %>" open>
    <summary class="admin-characters__summary section-title"><%= title %> (<%= list.size %>)</summary>
    <%= render "table", characters: list, groups: @groups, css: "admin-characters__#{key}-table", batch: key.in?(%w[ approved new ]) %>
  </details>
<% end %>

<% if (approved + new_ones).any? %>
  <%= form_with url: admin_character_batch_path, id: "character-batch", class: "form form--inline admin-batch admin-characters__batch" do |form| %>
    <%= form.label :decision, "With the ticked characters", class: "admin-batch__label" %>
    <%= form.select :decision, [ [ "Retire them", "retire" ], [ "Put them on the roster", "roster" ] ], include_blank: "Choose…" %>
    <%= form.submit "Apply", class: "button button--quiet", data: { turbo_confirm: "Do this to every ticked character?" } %>
  <% end %>
<% end %>

<%= render "forum_boards/pages", pages: @pages, current: @page %>
