<% content_for :title, "Characters · Inkwll" %>

<h1 class="page-title">Characters</h1>
<p class="text muted">Characters are never deleted. Retiring one stops it being played and takes it off the Where list and out of <%= term(:room, count: 2) %>; its <%= term(:pose, count: 2).downcase %> and <%= term(:log, count: 2).downcase %> stay, greyed out.</p>

<% retired, active = @characters.partition(&:retired?) %>
<%= render "table", characters: active, groups: @groups, css: "admin-characters__active" %>

<% if retired.any? %>
  <section class="admin-characters__retired">
    <h2 class="section-title">Retired characters (<%= retired.size %>)</h2>
    <%= render "table", characters: retired, groups: @groups, css: "admin-characters__retired-table" %>
  </section>
<% end %>
