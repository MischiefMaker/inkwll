<%# One table of characters on the staff Characters page. %>
<% batch = local_assigns[:batch] %>
<table class="table <%= css %>" <%= "data-controller=check-all" if batch %>>
  <thead class="table__head">
    <tr class="table__row"><% if batch %><th class="table__heading admin-batch__heading"><input type="checkbox" class="admin-batch__all" aria-label="Tick them all" data-check-all-target="all" data-action="check-all#toggle"></th><% end %><th class="table__heading">Character</th><th class="table__heading">Player</th><th class="table__heading"><%= term(:room) %></th><% if groups.any? %><th class="table__heading">Group</th><% end %><th class="table__heading"></th></tr>
  </thead>
  <tbody class="table__body">
    <% characters.each do |character| %>
      <tr class="table__row<%= " table__row--retired" if character.retired? %>">
        <% if batch %>
          <td class="table__cell admin-batch__cell"><%= check_box_tag "character_ids[]", character.id, false, id: "batch_character_#{character.id}", form: "character-batch", class: "admin-batch__tick",
                aria: { label: "Tick #{character.name}" }, data: { check_all_target: "item", action: "check-all#sync" } %></td>
        <% end %>
        <td class="table__cell"><%= link_to character.name, character %><%= tag.span(character.on_roster? ? " (on the roster)" : character.preparing_for_roster? ? " (being prepared for the roster)" : " (retired)", class: "muted") if character.retired? %></td>
        <td class="table__cell"><%= forum_author(character.account) %></td>
        <td class="table__cell"><%= link_to character.room.name, room_path(character.room) %></td>
        <% if groups.any? %>
          <td class="table__cell">
            <%= form_with model: character, url: admin_character_path(character), method: :patch, class: "form form--inline admin-characters__group", data: { controller: "auto-submit" } do |form| %>
              <%= form.label :character_group_id, "Group for #{character.name}", class: "visually-hidden" %>
              <%= form.select :character_group_id, groups.map { |group| [ group.name, group.id ] }, { include_blank: "None" }, data: { action: "change->auto-submit#submit" } %>
              <noscript><%= form.submit "Save", class: "button-link" %></noscript>
            <% end %>
          </td>
        <% end %>
        <td class="table__cell">
          <% if character.on_roster? || character.preparing_for_roster? %>
            <%= link_to character.on_roster? ? "On the roster" : "Being prepared", admin_roster_path, class: "muted" %>
            <%= button_to "Retire", retire_admin_character_path(character), class: "button-link",
                  form: { data: { turbo_confirm: "Retire #{character.name}? They come off the roster, and any applications for them are dropped." } } %>
          <% elsif character.roster_retired? %>
            <%= button_to "Put back on the roster", admin_roster_character_path(character), method: :patch, params: { decision: "open" }, class: "button-link" %>
          <% elsif character.retired? %>
            <% if character.deceased? %><span class="muted admin-characters__deceased">Deceased</span><% end %>
            <%= button_to "Bring back", unretire_admin_character_path(character), class: "button-link" %>
          <% else %>
            <%= button_to "Retire", retire_admin_character_path(character), class: "button-link",
                  form: { data: { turbo_confirm: "Retire #{character.name}? They can't be played until you bring them back." } } %>
            <%= button_to "Put on the roster", admin_roster_character_path(character), method: :patch, class: "button-link",
                  form: { data: { turbo_confirm: "Put #{character.name} on the roster? They stop being #{character.account.display_name}'s, and other players can apply to play them." } } %>
          <% end %>
          <% unless character.deceased? %>
            <details class="admin-characters__decease">
              <summary class="disclosure__summary button-link">Deceased</summary>
              <%= form_with url: decease_admin_character_path(character), class: "form form--inline admin-characters__decease-form" do |form| %>
                <%= form.label :deceased_note, "Epitaph for #{character.name} (optional)", class: "visually-hidden" %>
                <%= form.text_field :deceased_note, maxlength: 200, placeholder: "Epitaph (optional)" %>
                <%= form.submit "Mark as deceased", class: "button button--quiet", data: { turbo_confirm: "Mark #{character.name} as deceased? They're retired and go in the Graveyard. Bring back undoes it." } %>
              <% end %>
            </details>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
