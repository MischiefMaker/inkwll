<%= form_with model: [ :admin, area ], class: "form" do |form| %>
  <%= render "shared/errors", record: area %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>
  <div class="field">
    <%= form.label :parent_id, "Inside" %>
    <%= form.select :parent_id, Area.nested_options(except: area.persisted? ? area : nil), include_blank: "Nothing (shown on the front page)" %>
  </div>
  <% if area.persisted? %>
    <div class="field">
      <%= form.label :entrance_room_id, "Default #{term(:room).downcase}" %>
      <%= form.collection_select :entrance_room_id, area.all_rooms, :id, :name, include_blank: "The first #{term(:room).downcase} made in it" %>
      <small class="hint">Enter on the front page moves a character here. From there they walk the <%= term(:exit, count: 2).downcase %>. You can also tick "Default <%= term(:room).downcase %>" on a <%= term(:room).downcase %>'s own page.</small>
    </div>
  <% end %>
  <div class="field">
    <%= form.label :position, "Order" %>
    <%= form.number_field :position %>
    <small class="hint">Lower numbers are listed first.</small>
  </div>
  <%= render "shared/look_fields", form: form, record: form.object, rows: 4 %>
  <%= form.submit area.persisted? ? "Save" : "Create #{term(:area).downcase}", class: "button" %>
<% end %>
