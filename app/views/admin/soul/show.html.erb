<% content_for :title, "SOUL · Admin · Inkwll" %>

<h1 class="page-title">SOUL</h1>
<p class="text muted">The Aspects and Skills on every character's sheet. Each Skill belongs to one Aspect, and a character's Aspect rating adds a little to rolls of its Skills. The numbers for points, costs and difficulties are in <code class="code">config/soul.yml</code>.</p>

<% @aspects.each do |aspect| %>
  <section class="soul-admin__aspect">
    <h2 class="section-title soul-admin__aspect-name">
      <%= aspect.name %>
      <span class="soul-admin__actions">
        <%= edit_icon_link(edit_admin_soul_aspect_path(aspect)) %>
        <% if aspect.skills.empty? %>
          <%= delete_icon_button(admin_soul_aspect_path(aspect), label: "Delete", confirm: "Delete #{aspect.name}?") %>
        <% end %>
      </span>
    </h2>
    <% if aspect.description.present? %><p class="text muted"><%= aspect.description %></p><% end %>
    <% if aspect.skills.any? %>
      <table class="table soul-admin__skills">
        <thead class="table__head"><tr class="table__row"><th class="table__heading">Skill</th><th class="table__heading">About</th><th class="table__heading"></th></tr></thead>
        <tbody class="table__body">
          <% aspect.skills.each do |skill| %>
            <tr class="table__row">
              <td class="table__cell"><%= skill.name %></td>
              <td class="table__cell muted"><%= skill.description %></td>
              <td class="table__cell">
                <%= edit_icon_link(edit_admin_soul_skill_path(skill)) %>
                <%= delete_icon_button(admin_soul_skill_path(skill), label: "Delete", confirm: "Delete #{skill.name}? Every character's rating in it is deleted too.") %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% else %>
      <p class="text muted">No Skills yet.</p>
    <% end %>
  </section>
<% end %>

<% if @aspects.any? %>
  <h2 class="section-title">Add a Skill</h2>
  <%= render "admin/soul_skills/form", skill: @skill %>
<% end %>

<h2 class="section-title">Add an Aspect</h2>
<%= render "admin/soul_aspects/form", aspect: @aspect %>
