<% content_for :title, "Edit #{@room.name} · Inkwll" %>

<h1>Edit <%= link_to @room.name, room_path(@room) %></h1>

<%= render "form", room: @room %>

<h2>Exits</h2>
<p class="muted">Exits are one-way. To link two rooms both ways, add an exit in each room.</p>

<% if @room.exits.any? %>
  <ul class="list">
    <% @room.exits.includes(:destination_room).each do |room_exit| %>
      <li>
        <strong><%= room_exit.name %></strong> → <%= link_to room_exit.destination_room.name, edit_admin_room_path(room_exit.destination_room) %>
        <%= button_to "Remove", admin_room_exit_path(@room, room_exit), method: :delete, class: "button-link",
              form: { data: { turbo_confirm: "Remove the exit \"#{room_exit.name}\"?" } } %>
      </li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: [ :admin, @room, Exit.new ], class: "form form--inline" do |form| %>
  <div class="field">
    <%= form.label :name, "Exit name" %>
    <%= form.text_field :name, required: true, placeholder: "e.g. North" %>
  </div>
  <div class="field">
    <%= form.label :destination_room_id, "Leads to" %>
    <%= form.collection_select :destination_room_id, Room.where.not(id: @room.id).order(:name), :id, :name %>
  </div>
  <%= form.submit "Add exit", class: "button" %>
<% end %>
