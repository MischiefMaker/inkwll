<% content_for :title, "Edit #{@room.name} · Inkwll" %>

<h1 class="page-title">Edit <%= link_to @room.name, room_path(@room) %></h1>

<%= render "form", room: @room %>

<h2 class="section-title"><%= term(:exit, count: 2) %></h2>
<p class="muted">
  <%= term(:exit, count: 2) %> are one-way. Fill in "Return <%= term(:exit).downcase %>" to add the way back at the same time.
  Streets are the ordinary ways between places and can point a compass direction; the way back points the opposite way (north comes back south).
  Buildings are things to go into from here, and their way back is Out. Units are numbered doors, like apartments.
</p>

<% if @room.exits.any? %>
  <ul class="list">
    <% all_exits = @room.exits.includes(:destination_room).to_a %>
    <% (Exit.in_compass_order(all_exits.reject(&:number)) + Exit.in_number_order(all_exits.select(&:number))).each do |room_exit| %>
      <li class="list__item">
        <% if room_exit.direction %><span class="tag exit-direction"><%= room_exit.direction %></span><% end %>
        <% if room_exit.number %><span class="tag exit-number"><%= room_exit.number %></span><% end %>
        <% if room_exit.kind == "building" %><span class="tag exit-kind"><%= t("terms.exit_kind_names.building") %></span><% end %>
        <strong class="emphasis"><%= room_exit.name %></strong> → <%= link_to room_exit.destination_room.name, edit_admin_room_path(room_exit.destination_room) %>
        <%= edit_icon_link(edit_admin_room_exit_path(@room, room_exit), label: "Edit") %>
        <%= delete_icon_button(admin_room_exit_path(@room, room_exit), label: "Remove", confirm: "Remove the #{term(:exit).downcase} \"#{room_exit.name}\"?") %>
      </li>
    <% end %>
  </ul>
<% end %>

<%= form_with model: [ :admin, @room, Exit.new ], class: "form form--inline" do |form| %>
  <div class="field">
    <%= form.label :kind, "Type" %>
    <%= form.select :kind, Exit::KINDS.map { |kind| [ t("terms.exit_kind_names.#{kind}"), kind ] }, include_blank: "Pick it from what it leads to", selected: "" %>
    <small class="hint">Left alone, a Path to a building is a Building and any other is a Street.</small>
  </div>
  <div class="field">
    <%= form.label :direction, "Direction (optional)" %>
    <%= form.select :direction, Exit::DIRECTIONS.map { |short, long| [ short == long ? long : "#{short} (#{long})", short ] }, include_blank: "None" %>
    <small class="hint">Compass points are for streets.</small>
  </div>
  <div class="field">
    <%= form.label :number, "Number (optional)" %>
    <%= form.text_field :number, placeholder: "e.g. 101", size: 6, maxlength: 10 %>
    <small class="hint">Units need one. Numbered <%= term(:exit, count: 2).downcase %> show in a compact list, like "101 - Nestor Nash".</small>
  </div>
  <div class="field">
    <%= form.label :name, "#{term(:exit)} name" %>
    <%= form.text_field :name, placeholder: "e.g. Lamplight Café" %>
    <small class="hint">Leave empty to name it after its direction.</small>
  </div>
  <div class="field">
    <%= form.label :destination_room_id, "Leads to" %>
    <%= form.collection_select :destination_room_id, Room.where.not(id: @room.id).order(:name), :id, :name %>
  </div>
  <div class="field">
    <%= label_tag "exit_return_name", "Return #{term(:exit).downcase} (optional)" %>
    <%= text_field_tag "exit[return_name]", nil, id: "exit_return_name", placeholder: "e.g. Back to the square" %>
    <label class="field--checkbox"><%= check_box_tag "exit[add_return]", "1", false, id: "exit_add_return" %> Add the way back</label>
    <small class="hint">From a street, the way back points the opposite direction. From a building or unit, it's Out. Tick the box to add it even without a name.</small>
  </div>
  <%= form.submit "Add #{term(:exit).downcase}", class: "button" %>
<% end %>

<section class="numbered-rooms-builder">
  <h2 class="section-title">Add numbered <%= term(:room, count: 2).downcase %></h2>
  <p class="muted">
    For apartments, hotel rooms and the like. Each line makes a new <%= term(:room).downcase %> called
    "<%= @room.numbered_unit %> 100" in the same <%= term(:area).downcase %>, a numbered <%= term(:exit).downcase %> to it from here,
    and a <%= term(:exit).downcase %> back out. Write the number, then what the door says (often who lives there).
    Change the "Type of <%= term(:room).downcase %>" above first if you want them called something else.
  </p>
  <%= form_with url: admin_room_numbered_rooms_path(@room), class: "form numbered-rooms-builder__form" do |form| %>
    <div class="field">
      <%= form.label :lines, "One per line" %>
      <%= form.text_area :lines, value: params[:lines], rows: 6, class: "numbered-rooms-builder__lines",
            placeholder: "100 Jaxon Marley\n101 Nestor Nash\n203 Harry Potter" %>
      <small class="hint">Up to <%= NumberedRooms::MAX_LINES %> at a time. A line with just a number labels the door "<%= @room.numbered_unit %> 100".</small>
    </div>
    <div class="field">
      <%= form.label :return_name, "Name of the way back out" %>
      <%= form.text_field :return_name, value: "Out", maxlength: 40 %>
    </div>
    <%= form.submit "Add numbered #{term(:room, count: 2).downcase}", class: "button" %>
  <% end %>
</section>

<section class="admin-delete">
  <h2 class="section-title">Delete this <%= term(:room).downcase %></h2>
  <% if @room.deletable? %>
    <p class="muted">Nobody is in it and it has no <%= term(:scene, count: 2).downcase %>, so it can be deleted. Its <%= term(:exit, count: 2).downcase %>, and the ones leading here, are deleted with it. This can't be undone.</p>
    <%= button_to "Delete #{@room.name}", admin_room_path(@room), method: :delete, class: "button button--danger admin-delete__button",
          form: { data: { turbo_confirm: "Delete #{@room.name} and its #{term(:exit, count: 2).downcase}? This can't be undone." } } %>
  <% else %>
    <p class="muted admin-delete__blocked">It can't be deleted yet: <%= @room.deletion_blockers.to_sentence %></p>
  <% end %>
</section>
