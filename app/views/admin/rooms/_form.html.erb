<%= form_with model: [ :admin, room ], class: "form" do |form| %>
  <%= render "shared/errors", record: room %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>
  <div class="field">
    <%= form.label :area_id, term(:area) %>
    <%= form.select :area_id, Area.nested_options, {}, required: true %>
  </div>
  <div class="field room-kind">
    <%= form.label :kind, "Type of #{term(:room).downcase}" %>
    <%= form.select :kind, Room::KINDS.map { |key, kind| [ kind[:label], key ] } %>
    <small class="hint">An apartment building, hotel and so on lists its numbered <%= term(:exit, count: 2).downcase %> compactly, under a heading like "Apartments".</small>
  </div>
  <div class="field field--checkbox room-area-default">
    <%= form.check_box :area_default, checked: room.area_default? %>
    <%= form.label :area_default, "Default #{term(:room).downcase} for its #{term(:area).downcase}" %>
    <small class="hint">Enter on the front page moves a character here. If no <%= term(:room).downcase %> is ticked, it's the first one made in the <%= term(:area).downcase %>.</small>
  </div>
  <div class="field field--checkbox">
    <%= form.check_box :starting %>
    <%= form.label :starting, "New characters start here" %>
  </div>
  <%= render "shared/look_fields", form: form, record: form.object, rows: 8 %>
  <%= form.submit room.persisted? ? "Save" : "Create #{term(:room).downcase}", class: "button" %>
<% end %>
