<%= form_with model: [ :admin, room ], class: "form" do |form| %>
  <%= render "shared/errors", record: room %>

  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>
  </div>
  <div class="field">
    <%= form.label :area_id, term(:area) %>
    <%= form.select :area_id, Area.nested_options, {}, required: true %>
  </div>
  <div class="field field--checkbox">
    <%= form.check_box :starting %>
    <%= form.label :starting, "New characters start here" %>
  </div>
  <%= render "shared/look_fields", form: form, record: form.object, rows: 8 %>
  <%= form.submit room.persisted? ? "Save" : "Create #{term(:room).downcase}", class: "button" %>
<% end %>
