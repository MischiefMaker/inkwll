<%= form_with model: [ :admin, field ], class: "form profile-field-form" do |form| %>
  <%= render "shared/errors", record: field %>
  <div class="field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, maxlength: 60 %>
  </div>
  <div class="field">
    <%= form.label :section, "Where it goes" %>
    <%= form.select :section, [ [ "Demographics (top of the profile)", "demographics" ], [ "Application tab", "application" ] ] %>
  </div>
  <div class="field">
    <%= form.label :field_type, "Kind of answer" %>
    <%= form.select :field_type, ProfileField::FIELD_TYPES.map { |key, label| [ label, key ] } %>
  </div>
  <div class="field">
    <%= form.label :hint, "Help text (optional)" %>
    <%= form.text_field :hint, maxlength: 300 %>
  </div>
  <% if field.persisted? %>
    <div class="field">
      <%= form.label :position, "Order (lower comes first)" %>
      <%= form.number_field :position %>
    </div>
  <% end %>
  <div class="field field--checkbox">
    <%= form.check_box :public %>
    <%= form.label :public, "Everyone can see it (otherwise only the player and staff)" %>
  </div>
  <div class="field field--checkbox">
    <%= form.check_box :on_passages %>
    <%= form.label :on_passages, "Show beside #{term(:pose, count: 2).downcase} (only if everyone can see it)" %>
  </div>
  <div class="field field--checkbox profile-field-form__player-can-edit">
    <%= form.check_box :player_can_edit %>
    <%= form.label :player_can_edit, "Player can edit after approval" %>
  </div>
  <small class="hint">Untick for answers that shouldn't change once the character is approved, like Background. Staff can always edit.</small>
  <div class="field field--checkbox">
    <%= form.check_box :ask_on_roster %>
    <%= form.label :ask_on_roster, "Ask again when someone takes a character from the roster" %>
  </div>
  <small class="hint">The new player's answer replaces the old one. Use it for parts of the application they should redo, or add questions just for roster players.</small>
  <div class="field profile-field-form__inkling">
    <%= form.label :inkling_kind, "Start an Inkling from the answer" %>
    <%= form.select :inkling_kind, ProfileField.inkling_kinds.map { |key, name| [ name, key ] }, include_blank: "No, just keep it on the profile" %>
    <small class="hint">When staff approve a character, its answer here becomes an Inkling of this type, for the player to keep adding to. Works for short and long text answers.</small>
  </div>
  <div class="field field--checkbox">
    <%= form.check_box :required %>
    <%= form.label :required, "Must be filled in before submitting" %>
  </div>
  <%= form.submit class: "button" %>
<% end %>
