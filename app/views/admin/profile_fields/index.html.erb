<% content_for :title, "Profile fields · Admin · Inkwll" %>

<h1 class="page-title">Profile fields</h1>
<p class="muted">The questions on every character's profile. Name, Age and the description are always there.</p>

<% { "demographics" => "Demographics", "application" => "Application tab" }.each do |section, heading| %>
  <h2 class="section-title"><%= heading %></h2>
  <% fields = @fields[section] || [] %>
  <% if fields.any? %>
    <table class="table profile-fields-admin">
      <thead class="table__head"><tr class="table__row"><th class="table__heading">Field</th><th class="table__heading">Kind</th><th class="table__heading">Who sees it</th><th class="table__heading">Required</th><th class="table__heading"></th></tr></thead>
      <tbody class="table__body">
        <% fields.each do |field| %>
          <tr class="table__row">
            <td class="table__cell"><%= field.name %></td>
            <td class="table__cell"><%= ProfileField::FIELD_TYPES[field.field_type] %></td>
            <td class="table__cell"><%= field.public? ? "Everyone" : "Player and staff" %></td>
            <td class="table__cell"><%= field.required? ? "Yes" : "No" %></td>
            <td class="table__cell">
              <%= link_to "Edit", edit_admin_profile_field_path(field) %>
              <%= button_to "Delete", admin_profile_field_path(field), method: :delete, class: "button-link",
                    form: { data: { turbo_confirm: "Delete #{field.name}? What every character wrote in it is deleted too." } } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="muted">No fields here.</p>
  <% end %>
<% end %>

<h2 class="section-title">Add a field</h2>
<%= render "form", field: @field %>
