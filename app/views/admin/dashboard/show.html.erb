<% content_for :title, "Admin panel · Inkwll" %>

<h1 class="page-title">Admin panel</h1>
<p class="muted">
  You are a <strong class="emphasis"><%= t("terms.staff_levels.#{current_account.staff_level}") %></strong><%= " and a #{term(:founder)}" if current_account.founder? %>.
  You only see the parts of the menu your level allows.
  New here? Read <%= link_to "Getting started", admin_getting_started_path, class: "admin-guide-link" %>.
</p>

<% if current_account.can?(:change_game_settings) && !GameSetting.current.look_chosen_at %>
  <div class="notice-box admin-setup">
    <p class="text"><strong class="emphasis">Pick your game's look.</strong> It starts in <%= GameSetting::Skin::PRESETS[GameSetting::Skin::DEFAULT_PRESET][:name] %>; there are other ready-made looks, including plain, or you can set your own colours.</p>
    <%= link_to "Choose a look", edit_admin_skin_path, class: "button admin-setup__look" %>
  </div>
<% end %>

<nav class="admin-quick" aria-label="Quick actions">
  <% admin_quick_actions.each do |label, path, kind| %>
    <%= link_to label, path, class: "button admin-quick__button admin-quick__button--#{kind}" %>
  <% end %>
</nav>

<section class="admin-attention" aria-labelledby="admin-attention-heading">
  <h2 class="section-title admin-attention__heading" id="admin-attention-heading">Needs Attention</h2>
  <% waiting = StaffWaiting.pending_for(current_account) %>
  <% if waiting.any? %>
    <ul class="admin-attention__list">
      <% waiting.each do |item| %>
        <li class="admin-attention__item admin-attention__item--<%= item.key %>">
          <%= link_to staff_waiting_path(item.key), class: "admin-attention__link" do %>
            <span class="admin-attention__label"><%= item.label %></span>
            <span class="admin-attention__count"><%= item.count %></span>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted admin-attention__empty">Nothing is waiting on you right now.</p>
  <% end %>
</section>

<ul class="admin-sections">
  <% if current_account.can?(:build) %>
    <li class="list__item">
      <%= link_to "Building", admin_areas_path %>
      <span class="muted">Create and edit <%= term(:area, count: 2).downcase %>, <%= term(:room, count: 2).downcase %> and <%= term(:exit, count: 2).downcase %>.</span>
    </li>
  <% end %>
  <% if current_account.can?(:manage_staff) %>
    <li class="list__item">
      <%= link_to "Players and staff", admin_accounts_path %>
      <span class="muted">Set staff levels, <%= t("terms.staff_levels.page") %> jobs and <%= term(:storyteller) %> status.</span>
    </li>
  <% end %>
  <% if current_account.can?(:handle_reports) %>
    <li class="list__item">
      <%= link_to "Reports", admin_reports_path %>
      <span class="muted">Read reported <%= term(:scene, count: 2).downcase %>, lock them, hide <%= term(:pose, count: 2).downcase %> and warn players.</span>
    </li>
  <% end %>
  <% if current_account.can?(:ban) %>
    <li class="list__item">
      <%= link_to "Bans", admin_bans_path %>
      <span class="muted">Ban players and IP addresses, and block known VPNs.</span>
    </li>
  <% end %>
  <% if current_account.can?(:delete_characters) %>
    <li class="list__item">
      <%= link_to "Characters", admin_characters_path %>
      <span class="muted">See every character, and retire one if needed.</span>
    </li>
  <% end %>
  <% if current_account.can?(:change_game_settings) %>
    <li class="list__item">
      <%= link_to "Features", edit_admin_features_path %>
      <span class="muted">Switch SOUL, Inklings, Grimoire, the wiki and guest chat on or off.</span>
    </li>
    <li class="list__item">
      <%= link_to "Look", edit_admin_skin_path %>
      <span class="muted">The game's colours, fonts and extra CSS.</span>
    </li>
    <li class="list__item">
      <%= link_to "Game settings", edit_admin_game_settings_path %>
      <span class="muted">Whether email and character approval are required.</span>
    </li>
  <% end %>
</ul>
