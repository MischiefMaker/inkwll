<% content_for :title, "Edit #{@account.display_name} · Inkwll" %>

<h1 class="page-title"><%= @account.display_name %></h1>

<%= form_with model: [ :admin, @account ], class: "form" do |form| %>
  <%= render "shared/errors", record: @account %>

  <div class="field">
    <%= form.label :staff_level, "Staff level" %>
    <%= form.select :staff_level,
          current_account.assignable_staff_levels.map { |level| [ t("terms.staff_levels.#{level}"), level ] } %>
  </div>

  <fieldset class="field">
    <legend class="fieldset__legend"><%= t("terms.staff_levels.page") %> jobs</legend>
    <small class="hint">Only matter for <%= t("terms.staff_levels.page").pluralize %>. <%= t("terms.staff_levels.scribe").pluralize %> and <%= t("terms.staff_levels.wellkeeper").pluralize %> can do every job.</small>
    <%= hidden_field_tag "account[job_flags][]", "" %>
    <% Account::JOB_FLAGS.each do |flag| %>
      <label class="field--checkbox">
        <%= check_box_tag "account[job_flags][]", flag, @account.job_flags.include?(flag), id: "job_flag_#{flag}" %>
        <%= t("terms.job_flags.#{flag}") %> <%= t("terms.staff_levels.page") %>
      </label>
    <% end %>
  </fieldset>

  <div class="field field--checkbox">
    <%= form.check_box :storyteller %>
    <%= form.label :storyteller, term(:storyteller) %>
  </div>

  <%= form.submit "Save", class: "button" %>
<% end %>

<section class="account-password">
  <h2 class="section-title">Password</h2>
  <% if @reset_link %>
    <p class="text">Send this link to <%= @account.display_name %> privately, for example in Messages. It lets them pick a new password, works for one day, and stops working once they've used it.</p>
    <p class="account-password__link"><input type="text" class="account-password__link-field" value="<%= @reset_link %>" readonly aria-label="Password reset link"></p>
  <% else %>
    <p class="muted"><%= @account.email.present? ? "#{@account.display_name} can reset their own password from the log-in page, by email." : "#{@account.display_name} has no email, so they can't reset their own password." %> You can make a reset link to send them.</p>
    <%= button_to "Make a password reset link", reset_link_admin_account_path(@account), class: "button button--quiet account-password__button", form: { data: { turbo: false } } %>
  <% end %>
</section>

<% if current_account.can?(:ban) %>
  <section class="account-safety">
    <h2 class="section-title">Safety</h2>
    <% addresses = @account.sessions.where.not(ip_address: nil).order(created_at: :desc).limit(10).pluck(:ip_address).uniq %>
    <p class="muted">Recent IP addresses: <%= addresses.any? ? addresses.join(", ") : "none recorded" %></p>
    <p class="text">
      <%= link_to "Ban #{@account.display_name}", new_admin_ban_path(account_id: @account.id) %> ·
      <%= link_to "Warn #{@account.display_name}", new_admin_warning_path(account_id: @account.id) %>
    </p>
  </section>
<% end %>
