<% content_for :title, "Players and staff · Inkwll" %>

<h1 class="page-title">Players and staff</h1>

<% waiting = Account.waiting_for_approval.order(:created_at) %>
<% if waiting.any? %>
  <section class="account-approvals">
    <h2 class="section-title">New players waiting for approval</h2>
    <ul class="list account-approvals__list">
      <% waiting.each do |account| %>
        <li class="list__item account-approvals__item">
          <%= forum_author(account) %> <span class="muted">signed up <%= time_ago_in_words(account.created_at) %> ago<%= " · #{account.email}" if account.email.present? %></span>
          <%= button_to "Approve", admin_account_approval_path(account), method: :patch, class: "button button--quiet account-approvals__approve", form_class: "account-approvals__form" %>
          <%= button_to "Turn away", admin_account_approval_path(account), method: :delete, class: "button-link account-approvals__decline", form_class: "account-approvals__form",
                form: { data: { turbo_confirm: "Turn #{account.display_name} away? Their account is archived and they can't log in." } } %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<table class="table admin-accounts" data-controller="check-all">
  <thead class="table__head">
    <tr class="table__row"><th class="table__heading admin-batch__heading"><input type="checkbox" class="admin-batch__all" aria-label="Tick them all" data-check-all-target="all" data-action="check-all#toggle"></th><th class="table__heading">Player</th><th class="table__heading">Level</th><th class="table__heading">Jobs and flags</th><th class="table__heading"></th></tr>
  </thead>
  <tbody class="table__body">
    <% @accounts.each do |account| %>
      <tr class="table__row<%= " table__row--archived" if account.archived? %>">
        <td class="table__cell admin-batch__cell">
          <% if current_account.can_manage?(account) && !account.archived? && account != current_account %>
            <%= check_box_tag "account_ids[]", account.id, false, id: "batch_account_#{account.id}", form: "account-batch", class: "admin-batch__tick",
                  aria: { label: "Tick #{account.display_name}" }, data: { check_all_target: "item", action: "check-all#sync" } %>
          <% end %>
        </td>
        <td class="table__cell"><%= forum_author(account) %>
          <% if account.archived? %><span class="badge account-archived">Archived</span><% end %>
          <% if account.muted_until&.future? %>
            <span class="badge account-muted">Muted for posting too fast</span>
            <%= button_to "Lift", unmute_admin_account_path(account), class: "button-link" %>
          <% end %>
        </td>
        <td class="table__cell"><%= t("terms.staff_levels.#{account.staff_level}") %><%= " (#{term(:founder)})" if account.founder? %></td>
        <td class="table__cell">
          <%= safe_join(account.job_flags.map { |flag| t("terms.job_flags.#{flag}") + " " + t("terms.staff_levels.page") }, ", ") %>
          <% if account.storyteller? %><span class="tag"><%= term(:storyteller) %></span><% end %>
        </td>
        <td class="table__cell account-actions">
          <% if current_account.can_manage?(account) %>
            <%= edit_icon_link(edit_admin_account_path(account)) %>
            <% unless account.archived? %>
              <%= button_to "Archive", archive_admin_account_path(account), class: "button-link",
                    form: { data: { turbo_confirm: "Archive #{account.display_name}? They can't log in again, and their characters are retired or go on the roster." } } %>
            <% end %>
            <% if current_account.founder? && !@with_characters.include?(account.id) %>
              <%= delete_icon_button(admin_account_path(account), label: "Delete", confirm: "Delete #{account.display_name} for good? This can't be undone.", css: "account-actions__delete") %>
            <% end %>
          <% end %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= form_with url: admin_account_batch_path, id: "account-batch", class: "form form--inline admin-batch admin-accounts__batch" do |form| %>
  <%= hidden_field_tag :decision, "archive" %>
  <span class="admin-batch__label">With the ticked players:</span>
  <%= form.submit "Archive them", class: "button button--quiet",
        data: { turbo_confirm: "Archive every ticked player? They can't log in again, and their characters are retired or go on the roster." } %>
<% end %>

<%= render "forum_boards/pages", pages: @pages, current: @page %>

<p class="muted">
  You can edit players below your own level. Only a <%= term(:founder) %> can make someone a
  <%= t("terms.staff_levels.wellkeeper") %>, and the <%= term(:founder) %> flag is only set on the server.
  Accounts are archived rather than deleted. A <%= term(:founder) %> can delete an account that never had any characters.
</p>
