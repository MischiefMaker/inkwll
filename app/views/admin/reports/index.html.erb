<% content_for :title, "Reports · Admin · Inkwll" %>

<h1 class="page-title">Reports</h1>
<p class="muted">Opening a report lets you read that one <%= term(:scene).downcase %>, even if it's private or hidden.</p>

<h2 class="section-title">Open</h2>
<% if @open.any? %>
  <table class="table">
    <thead class="table__head"><tr class="table__row"><th class="table__heading"><%= term(:scene) %></th><th class="table__heading">Reported by</th><th class="table__heading">When</th><th class="table__heading">Reason</th></tr></thead>
    <tbody class="table__body">
      <% @open.each do |report| %>
        <tr class="table__row">
          <td class="table__cell"><%= link_to report.scene.title, admin_report_path(report) %><%= " (one #{term(:pose).downcase})" if report.pose %></td>
          <td class="table__cell"><%= report.account.display_name %></td>
          <td class="table__cell"><%= time_ago_in_words(report.created_at) %> ago</td>
          <td class="table__cell"><%= truncate(report.reason, length: 80) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="muted">No open reports.</p>
<% end %>

<% if @resolved.any? %>
  <h2 class="section-title">Closed</h2>
  <ul class="list">
    <% @resolved.each do |report| %>
      <li class="list__item">
        <%= link_to report.scene.title, admin_report_path(report) %>
        <span class="muted">closed by <%= report.resolved_by&.display_name %>, <%= time_ago_in_words(report.resolved_at) %> ago<%= ": #{report.resolution}" if report.resolution %></span>
      </li>
    <% end %>
  </ul>
<% end %>
