<% content_for :title, "Game settings · Inkwll" %>

<h1 class="page-title">Game settings</h1>

<%= form_with model: @game_setting, url: admin_game_settings_path, method: :patch, class: "form" do |form| %>
  <%= render "shared/errors", record: @game_setting %>
  <div class="field field--checkbox">
    <%= form.check_box :email_required %>
    <%= form.label :email_required, "New accounts must give an email address" %>
  </div>
  <p class="muted">When this is off, email is optional. Players without one ask staff to reset their password.</p>

  <div class="field field--checkbox">
    <%= form.check_box :approval_required %>
    <%= form.label :approval_required, "Characters need staff approval before they can play" %>
  </div>
  <p class="muted">Until approved, characters can explore but can't join <%= term(:scene, count: 2).downcase %>. Applications are under Applications in the admin panel.</p>

  <div class="field field--checkbox">
    <%= form.check_box :require_description %>
    <%= form.label :require_description, "Characters need a written description before they're submitted" %>
  </div>
  <div class="field field--checkbox">
    <%= form.check_box :require_icon %>
    <%= form.label :require_icon, "Characters need an icon before they're submitted" %>
  </div>
  <p class="muted">The questions on profiles and applications are under Profile fields.</p>

  <h2 class="section-title">Game date</h2>
  <div class="field">
    <%= form.label :ic_today, "Today's date in the game" %>
    <%= form.date_field :ic_today, value: @game_setting.ic_today %>
    <small class="hint">From now on it moves by itself. Characters' ages are worked out from their birthdays using it. Leave empty to use the real date.</small>
  </div>
  <div class="field">
    <%= form.label :ic_days_per_day, "Game days that pass per real day" %>
    <%= form.number_field :ic_days_per_day, min: 0.01, max: 365, step: 0.01 %>
    <small class="hint">1 means game time runs at the same speed as real time; 3 means three game days pass every real day.</small>
  </div>
  <div class="field">
    <%= form.label :weather, "Today's weather (optional)" %>
    <%= form.text_field :weather, maxlength: 200, placeholder: "Rain over the hills, clearing by evening" %>
    <small class="hint">Shown with the game date on the front page. Change it whenever you like.</small>
  </div>

  <div class="field field--checkbox">
    <%= form.check_box :players_public %>
    <%= form.label :players_public, "Everyone can see who plays which character" %>
  </div>
  <p class="muted">When this is off, only staff can see it. Players can still message "the player of" a character, who stays anonymous.</p>

  <p class="muted">SOUL, Inklings, Grimoire, the wiki and guest chat are switched on and off under Features.</p>

  <h2 class="section-title"><%= term(:scene, count: 2) %></h2>
  <div class="field field--checkbox">
    <%= form.check_box :auto_skip %>
    <%= form.label :auto_skip, "New #{term(:scene, count: 2).downcase} auto-skip players who don't take their turn" %>
  </div>
  <div class="field">
    <%= form.label :turn_minutes, "Minutes before the turn warning" %>
    <%= form.number_field :turn_minutes, min: 1, max: 120 %>
    <small class="hint">Each <%= term(:scene).downcase %> can change both of these.</small>
  </div>
  <div class="field">
    <%= form.label :idle_days, "Days without a #{term(:pose).downcase} before a #{term(:scene).downcase} counts as idle" %>
    <%= form.number_field :idle_days, min: 1, max: 365 %>
  </div>
  <div class="field">
    <%= form.label :auto_finish_days, "Days without a #{term(:pose).downcase} before a #{term(:scene).downcase} finishes on its own" %>
    <%= form.number_field :auto_finish_days, min: 2, max: 3650 %>
  </div>
  <div class="field">
    <%= form.label :roster_idle_days, "Days without posting or moving before a character goes back on the roster" %>
    <%= form.number_field :roster_idle_days, min: 7, max: 3650 %>
    <small class="hint">Only for characters whose players ticked "put on the roster if they go idle".</small>
  </div>

  <%= form.submit "Save", class: "button" %>
<% end %>
