<%# One finished Chapter in a list of Manuscripts. %>
<article class="manuscript">
  <h2 class="manuscript__title">
    <%= link_to scene.title, scene_path(scene) %>
    <% unless scene.visibility_joinable? %><span class="badge badge--<%= scene.visibility %>"><%= scene_visibility_label(scene) %></span><% end %>
  </h2>
  <p class="muted manuscript__meta">
    <%= link_to scene.room.name, archives_path(room_id: scene.room_id) %>
    · finished <%= scene.finished_at.to_date.to_fs(:long) %>
    · <%= safe_join(scene.participants.map { |p| link_to(p.character.name, archives_path(character_id: p.character_id)) }, ", ") %>
  </p>
</article>
