<%# The alerts bell in the header, with how many alerts are unread.
    Replaced live when an alert arrives. It sits in the summary of the
    header's alerts drop-down (see shared/_header). %>
<% unread = account.alerts.unread.count %>
<span id="alert_count" class="alert-bell<%= " alert-bell--unread" if unread.positive? %>" title="<%= unread.positive? ? pluralize(unread, "new alert") : "Alerts" %>">
  <svg class="alert-bell__icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
  <span class="visually-hidden">Alerts</span><% if unread.positive? %> <span class="alert-bell__number"><%= unread %></span><% end %>
</span>
