<% content_for :title, "Where · Inkwll" %>

<h1>Where</h1>
<p class="muted">Where everyone is standing, and the open <%= term(:scene, count: 2).downcase %> they're in.</p>

<% @characters.group_by(&:room).sort_by { |room, _| room.name }.each do |room, characters| %>
  <section class="where-room">
    <% if room.area %>
      <p class="where-room__areas"><%= (room.area.ancestors + [ room.area ]).map(&:name).join(" › ") %></p>
    <% end %>
    <h2><%= link_to room.name, room_path(room) %></h2>
    <ul class="list where-room__list">
      <% characters.each do |character| %>
        <li>
          <%= link_to character.name, character %>
          <% elsewhere = (@open_scenes[character.id] || []).map(&:scene) %>
          <% if elsewhere.any? %>
            <span class="muted">
              in
              <%= safe_join(elsewhere.map { |scene|
                    link_to(scene.title, scene_path(scene)) + (scene.room_id == room.id ? "" : " (#{scene.room.name})")
                  }, ", ") %>
            </span>
          <% end %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>
