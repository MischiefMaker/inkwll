<%= form_with model: @page, url: (@page.persisted? ? wiki_page_path(@page.slug_was) : wiki_pages_path), class: "form wiki-form", data: { controller: "wiki-preview draft", wiki_preview_url_value: preview_wiki_pages_path,
      draft_key_value: "wiki-#{@page.persisted? ? @page.id : "new"}", action: "turbo:submit-end->draft#posted" } do |form| %>
  <% if @page.errors.any? %>
    <p class="flash flash--alert"><%= @page.errors.full_messages.to_sentence %></p>
  <% end %>
  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, maxlength: 100 %>
  </div>
  <div class="field">
    <%= form.label :body, "Page" %>
    <div class="wiki-form__tabs" role="tablist">
      <button type="button" class="wiki-form__tab is-current" data-wiki-preview-target="editTab" data-action="wiki-preview#edit">Edit</button>
      <button type="button" class="wiki-form__tab" data-wiki-preview-target="previewTab" data-action="wiki-preview#show">Preview</button>
    </div>
    <%= form.text_area :body, rows: 20, maxlength: 100_000, class: "wiki-form__body", data: { wiki_preview_target: "body", draft_target: "field", action: "input->draft#save" } %>
    <div class="wiki-form__preview wiki-body" data-wiki-preview-target="preview" hidden></div>
    <details class="hint wiki-form__help">
      <summary class="disclosure__summary">How to format a page</summary>
      <ul class="wiki-form__help-list">
        <li><code>## Heading</code>, <code>**bold**</code>, <code>*italic*</code>, <code>- list item</code>, <code>[link](https://…)</code></li>
        <li><code>[[Page name]]</code> or <code>[[Page name|words to show]]</code> links to another wiki page.</li>
        <li>On a line of its own, these show live lists from the game:
          <code>{{characters}}</code>, <code>{{characters group="Ravens"}}</code>, <code>{{characters roster}}</code>,
          <code>{{character name="Ash Ravenscroft"}}</code>,
          <code>{{manuscripts place="The Commons" label="Plot" limit=5}}</code>,
          <code>{{places area="Ravenhollow"}}</code>, <code>{{pages tag="lore"}}</code></li>
        <li>Lists of pages: <code>{{pages tags="+lore -secret" order="updated" show="summary" limit=10}}</code>.
          <code>tags</code>: <code>+</code> must have, <code>-</code> must not have, plain words any of them. <code>prefix="House "</code> for titles starting with those words.
          <code>order</code>: title, newest, oldest, updated or random. <code>show</code>: list, summary or table.
          Also <code>{{tags}}</code> (every tag) and <code>{{backlinks}}</code> (pages that link here).</li>
        <li>An infobox, a box of facts at the side of the page: a line <code>{{infobox}}</code> (or <code>{{infobox title="Wren Ashdown"}}</code>),
          then one <code>Label: value</code> per line, a picture <code>![Wren](https://…)</code> or a <code>## Heading</code>, and a line <code>{{/infobox}}</code> to end it.</li>
      </ul>
    </details>
  </div>
  <div class="field">
    <%= form.label :tag_list, "Tags" %>
    <%= form.text_field :tag_list, maxlength: 400, placeholder: "lore, rules" %>
    <small class="hint">Separate tags with commas.</small>
  </div>
  <% if current_account.staff? %>
    <div class="field">
      <%= form.label :menu_position, "Place in the Menu (staff)" %>
      <%= form.number_field :menu_position, min: 0, max: 999 %>
      <small class="hint">Leave empty to keep it out of the Menu. Lower numbers come first.</small>
    </div>
  <% end %>
  <% if @page.persisted? %>
    <div class="field">
      <%= label_tag :summary, "What did you change?" %>
      <%= text_field_tag :summary, params[:summary], maxlength: 200, placeholder: "Optional" %>
    </div>
  <% end %>
  <%= form.submit "Save page", class: "button" %>
<% end %>
