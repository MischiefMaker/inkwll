<% content_for :title, "#{@revision.title} (old version) · Wiki · Inkwll" %>
<article class="wiki-page wiki-page--revision">
  <p class="muted wiki-page__crumbs"><%= link_to "Wiki", wiki_pages_path %> · <%= link_to @page.title, wiki_page_path(@page) %> · <%= link_to "History", wiki_page_revisions_path(@page) %></p>
  <div class="wiki-page__header">
    <h1 class="page-title wiki-page__title"><%= @revision.title %></h1>
    <% if @page.editable_by?(current_account) %>
      <div class="wiki-page__actions">
        <%= button_to "Put this version back", wiki_page_revision_path(@page, @revision), method: :patch, class: "button" %>
      </div>
    <% end %>
  </div>
  <p class="muted wiki-page__revision-note">
    The version saved <%= @revision.created_at.to_fs(:long) %> by <%= @revision.account ? forum_author(@revision.account) : "someone" %>.
  </p>
  <%= render_wiki(@revision.body) %>
</article>
