<% content_for :title, "#{@page.title} · Wiki · Inkwll" %>

<article class="wiki-page">
  <p class="muted wiki-page__crumbs"><%= link_to "Wiki", wiki_pages_path %></p>
  <div class="wiki-page__header">
    <h1 class="page-title wiki-page__title"><%= @page.title %></h1>
    <div class="wiki-page__actions">
      <% if @page.editable_by?(current_account) %><%= edit_icon_link(edit_wiki_page_path(@page)) %><% end %>
      <%= link_to "History", wiki_page_revisions_path(@page), class: "button button--quiet" %>
      <% if current_account&.staff? %>
        <% if @page.locked? %>
          <%= button_to "Unlock", wiki_page_lock_path(@page), method: :delete, class: "button button--quiet" %>
        <% else %>
          <%= button_to "Lock", wiki_page_lock_path(@page), class: "button button--quiet" %>
        <% end %>
      <% end %>
      <% if current_account&.can?(:manage_staff) %>
        <%= delete_icon_button(wiki_page_path(@page), label: "Delete", confirm: "Delete this page and all its history?", css: "wiki-page__delete") %>
      <% end %>
    </div>
  </div>

  <%= render_wiki(@page.body) %>

  <footer class="muted wiki-page__footer">
    <% if @page.tags.any? %>
      <span class="wiki-page__tags"><% @page.tags.each do |tag| %><%= link_to tag, wiki_pages_path(tag: tag), class: "tag wiki__tag" %> <% end %></span>
    <% end %>
    <% if @page.locked? %><span class="wiki-page__locked">Locked: only staff can change this page.</span><% end %>
    <span class="wiki-page__updated">Last changed <%= time_ago_in_words(@page.updated_at) %> ago<% if @page.updated_by %> by <%= forum_author(@page.updated_by) %><% end %>.</span>
  </footer>
</article>
