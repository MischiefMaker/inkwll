<nav class="breadcrumbs" aria-label="Where this is">
  <% crumbs = area.ancestors.map { |ancestor| link_to ancestor.name, area_path(ancestor) } %>
  <% crumbs << link_to(area.name, area_path(area)) if local_assigns[:include_self] %>
  <% crumbs.unshift(link_to("Home", root_path)) unless local_assigns[:skip_home] %>
  <%= safe_join(crumbs, tag.span(" › ", aria: { hidden: true })) %>
</nav>
