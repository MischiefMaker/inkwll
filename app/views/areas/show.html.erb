<% content_for :title, "#{@area.name} · Inkwll" %>

<%= render "areas/breadcrumbs", area: @area %>

<% page_background(@area) %>
<h1 class="page-title"><%= place_icon(@area, :compass, css: "page-title__icon") %><%= @area.name %></h1>
<%= render "shared/description", record: @area, default_banner: true %>
<% if Domain.enabled? && (domain = Domain.includes(:holder_character, :holder_faction).find_by(area: @area)) %>
  <p class="area-domain muted"><%= link_to domain.name, domains_path(anchor: "domain-#{domain.id}"), class: "area-domain__name" %><% if domain.rank %> (<%= domain.rank %>)<% end %><% holder = domain.holder_character&.retired? ? nil : domain.holder %><% if holder.is_a?(Character) %>, held by <%= link_to holder.name, character_path(holder), class: "area-domain__holder" %><% elsif holder && Faction.enabled? && Faction.visible_to(current_account).exists?(holder.id) %>, held by <%= link_to holder.name, faction_path(holder), class: "area-domain__holder" %><% end %></p>
<% end %>

<% listed_rooms = @area.rooms.listed %>
<% if listed_rooms.any? %>
  <section class="board">
    <h2 class="board__title"><%= term(:room, count: 2) %></h2>
    <ul class="board__rows">
      <% listed_rooms.includes(:characters).each do |room| %>
        <li class="board__row">
          <%= link_to room_path(room), class: "board__name" do %><%= place_icon(room, :door, css: "board__icon") %><%= room.name %><% end %><%= turn_quill(room.id) %>
          <% if room.summary %><span class="board__summary"><%= room.summary %></span><% end %>
          <span class="muted">
            <% if room.characters.any? %><%= pluralize(room.characters.size, "character") %> here<% end %>
          </span>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<%= render partial: "areas/card", collection: @area.children.includes(:children, rooms: :characters), as: :area %>

<% if @area.rooms.none? && @area.children.none? %>
  <p class="muted">Nothing here yet.</p>
<% end %>

<% if current_account&.can?(:build) %>
  <p class="text"><%= link_to "Edit #{term(:area).downcase}", edit_admin_area_path(@area) %></p>
<% end %>
