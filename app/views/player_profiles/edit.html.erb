<% content_for :title, "My profile · Inkwll" %>

<h1 class="page-title">My player profile</h1>
<p class="muted">The out-of-character you. <%= GameSetting.current.players_public? ? "Your characters are listed on it." : "It doesn't show which characters you play." %></p>

<%= form_with model: @player, url: player_profile_path, method: :patch, class: "form player-profile-form" do |form| %>
  <%= render "shared/errors", record: @player %>
  <div class="field">
    <%= form.label :display_name, "Player name" %>
    <%= form.text_field :display_name, required: true, maxlength: 30 %>
    <small class="hint">Also what you log in with. Staff keep a log of name changes.</small>
  </div>
  <div class="field">
    <%= form.label :icon %>
    <% if @player.icon.attached? && @player.icon.blob.persisted? %>
      <%= player_avatar(@player, size: :large) %>
      <label class="field--checkbox"><%= form.check_box :remove_icon %> Remove this icon</label>
    <% end %>
    <%= form.file_field :icon, accept: "image/png,image/jpeg,image/gif,image/webp" %>
    <small class="hint">Shown on your profile and beside your messages in the OOC Chat. PNG, JPEG, GIF or WebP, up to 5 MB.</small>
  </div>
  <div class="field">
    <%= form.label :about_me, "About me" %>
    <%= form.text_area :about_me, rows: 8 %>
  </div>
  <fieldset class="fieldset player-profile-form__away">
    <legend class="fieldset__legend">Away notice</legend>
    <div class="field">
      <%= form.label :away_until, "Away until" %>
      <%= form.date_field :away_until, min: Date.current, max: 1.year.from_now.to_date %>
    </div>
    <div class="field">
      <%= form.label :away_note, "Note (optional)" %>
      <%= form.text_field :away_note, maxlength: 100, placeholder: "e.g. On holiday, back for the weekend" %>
    </div>
    <small class="hint">Shows on your <%= term(:scene, count: 2).downcase %> beside whose turn it is, so others know to wait or skip you. It clears itself after that day. Leave the date empty to clear it now.</small>
  </fieldset>
  <%= form.submit "Save", class: "button" %>
<% end %>
