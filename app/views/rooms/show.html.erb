<% content_for :title, "#{@room.name} · Inkwll" %>
<%# Reloads this page live when someone enters or leaves. %>
<%= turbo_stream_from @room %>

<article class="room">
  <%= render "areas/breadcrumbs", area: @room.area, include_self: true %>
  <% page_background(@room) %>
  <%= render "rooms/area_intro", area: @room.area %>
  <h1 class="page-title"><%= place_icon(@room, :door, css: "page-title__icon") %><%= @room.name %></h1>
  <% if current_account %>
    <div class="room__save">
      <% if current_account.saved_places.exists?(room: @room) %>
        <%= button_to "★ In My places", room_saved_place_path(@room), method: :delete, class: "button-link room__saved", title: "Remove from My places" %>
      <% else %>
        <%= button_to "☆ Save to My places", room_saved_place_path(@room), class: "button-link" %>
      <% end %>
    </div>
  <% end %>

  <%# No drawn banner when the Area's own banner is already shown above. %>
  <%= render "shared/description", record: @room, default_banner: !@room.area&.image&.attached? %>

  <% here = current_character&.room_id == @room.id %>
  <% unless here %>
    <div class="from-afar">
      <% if !current_account %>
        <p class="muted from-afar__preview">
          You're previewing as a guest: follow the <%= term(:exit, count: 2).downcase %> to look around.
          <%= link_to "Log in", new_session_path %> or <%= link_to "sign up", new_registration_path %> to play.
        </p>
      <% elsif current_character %>
        <p class="muted">
          You're looking in from afar. <%= current_character.name %> is in
          <%= link_to current_character.room.name, room_path(current_character.room) %>.
        </p>
        <%= button_to "Travel here", room_travel_path(@room), class: "button" %>
      <% else %>
        <p class="muted"><%= link_to "Create a character", new_character_path %> to explore.</p>
      <% end %>
    </div>
  <% end %>

  <%# The way around the grid: Paths out of here and who's standing here,
      right under the description, before the Chapters. %>
  <div class="room-ways">
    <section class="room-paths">
      <h2 class="section-title"><%= term(:exit, count: 2) %></h2>
      <%# Streets (with the compass) first, then the rest by the type of Place. Numbered
          units get their own compact list below. %>
      <% all_exits = @room.exits.includes(:destination_room).to_a %>
      <% exits = Exit.in_compass_order(all_exits.reject(&:number)) %>
      <% streets = exits.select { |e| e.kind == "street" } %>
      <% if GameSetting.current.compass_enabled? && streets.any?(&:compass?) %>
        <%= render "rooms/compass", room: @room, exits: streets, here: here %>
      <% end %>
      <% if exits.any? %>
        <% grouped = exits.group_by(&:path_group) %>
        <% Exit::PATH_GROUPS.each do |group, heading| %>
          <% next unless grouped[group]&.any? %>
          <h3 class="room-paths__heading room-paths__heading--<%= group %>"><%= heading %></h3>
          <%= render "rooms/path_list", exits: grouped[group], here: here, kind: group %>
        <% end %>
      <% elsif all_exits.none? %>
        <p class="muted">There are no <%= term(:exit, count: 2).downcase %> out of here.</p>
      <% end %>
      <%= render "rooms/numbered_paths", room: @room, exits: all_exits, here: here %>
    </section>

    <section class="room-here">
      <h2 class="section-title">Here</h2>
      <%# Visitors previewing without logging in show as "Guest" or "3 Guests". %>
      <% guests = GuestVisit.count_in(@room) %>
      <% if @room.characters.any? || guests.positive? %>
        <ul class="list list--inline">
          <% @room.characters.each do |character| %>
            <li class="list__item"><%= character_name_link(character) %><%= new_player_badge(character) %></li>
          <% end %>
          <% if guests.positive? %>
            <li class="list__item room-here__guests"><%= guests == 1 ? "Guest" : "#{guests} Guests" %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">Nobody is here.</p>
      <% end %>
    </section>
  </div>

  <% if Crafting.items_enabled? && (listings = Crafting::ShopListing.where(room: @room).includes(catalogue_item: { image_attachment: :blob }).to_a).any? %>
    <%= render "rooms/shop", room: @room, listings: listings %>
  <% end %>

  <%= render "scenes/list", room: @room %>

  <% if current_account&.can?(:build) %>
    <p class="text"><%= link_to "Edit #{term(:room).downcase}", edit_admin_room_path(@room) %></p>
  <% end %>
</article>
