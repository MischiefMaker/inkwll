<% content_for :title, "#{@room.name} · Inkwll" %>
<%# Reloads this page live when someone enters or leaves. %>
<%= turbo_stream_from @room %>

<article class="room">
  <%= render "areas/breadcrumbs", area: @room.area, include_self: true %>
  <% page_background(@room) %>
  <h1 class="page-title"><% if @room.icon.attached? %><%= image_tag @room.icon, alt: "", class: "page-title__icon" %><% end %><%= @room.name %></h1>
  <div class="room__save">
    <% if current_account.saved_places.exists?(room: @room) %>
      <%= button_to "★ In My places", room_saved_place_path(@room), method: :delete, class: "button-link room__saved", title: "Remove from My places" %>
    <% else %>
      <%= button_to "☆ Save to My places", room_saved_place_path(@room), class: "button-link" %>
    <% end %>
  </div>

  <%= render "shared/description", record: @room %>

  <% here = current_character&.room_id == @room.id %>
  <% unless here %>
    <div class="from-afar">
      <% if current_character %>
        <p class="muted">
          You're looking in from afar. <%= current_character.name %> is in
          <%= link_to current_character.room.name, room_path(current_character.room) %>.
        </p>
        <%= button_to "Travel here", room_travel_path(@room), class: "button" %>
      <% else %>
        <p class="muted"><%= link_to "Create a character", new_character_path %> to explore.</p>
      <% end %>
    </div>
  <% end %>

  <%# The way around the grid: Paths out of here and who's standing here,
      right under the description, before the Chapters. %>
  <div class="room-ways">
    <section class="room-paths">
      <h2 class="section-title"><%= term(:exit, count: 2) %></h2>
      <% exits = Exit.in_compass_order(@room.exits.includes(:destination_room)) %>
      <% if GameSetting.current.compass_enabled? && exits.any?(&:direction) %>
        <%= render "rooms/compass", room: @room, exits: exits, here: here %>
      <% end %>
      <% if exits.any? %>
        <ul class="exits">
          <% exits.each do |room_exit| %>
            <li class="list__item">
              <% label = capture do %><% if room_exit.direction %><span class="exit-link__direction"><%= room_exit.direction %></span> <% end %><%= room_exit.name %><% end %>
              <% if here %>
                <%= button_to exit_movement_path(room_exit), class: "exit-link", title: "Go to #{room_exit.destination_room.name}" do %><%= label %><% end %>
              <% else %>
                <span class="exit-link exit-link--disabled"><%= label %></span>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">There are no <%= term(:exit, count: 2).downcase %> out of here.</p>
      <% end %>
    </section>

    <section class="room-here">
      <h2 class="section-title">Here</h2>
      <% if @room.characters.any? %>
        <ul class="list list--inline">
          <% @room.characters.each do |character| %>
            <li class="list__item"><%= character_name_link(character) %></li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">Nobody is here.</p>
      <% end %>
    </section>
  </div>

  <%= render "scenes/list", room: @room %>

  <% if current_account.can?(:build) %>
    <p class="text"><%= link_to "Edit #{term(:room).downcase}", edit_admin_room_path(@room) %></p>
  <% end %>
</article>
