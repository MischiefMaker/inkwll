<% content_for :title, "All #{term(:room, count: 2).downcase} · Inkwll" %>

<h1 class="page-title">All <%= term(:room, count: 2).downcase %></h1>

<ul class="list">
  <% @rooms.each do |room| %>
    <li class="list__item"><%= link_to room.name, room_path(room) %> <span class="muted">in <%= room.area.name %></span></li>
  <% end %>
</ul>
