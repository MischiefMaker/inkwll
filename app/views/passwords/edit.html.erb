<% content_for :title, "Pick a new password · Inkwll" %>

<h1 class="page-title">Pick a new password</h1>

<%= form_with url: password_path(params[:token]), method: :put, class: "form" do |form| %>
  <div class="field">
    <%= form.label :password, "New password" %>
    <%= form.password_field :password, required: true, autofocus: true, autocomplete: "new-password", minlength: 10, maxlength: 72 %>
    <small class="hint">At least 10 characters, with a number, a capital and a lower-case letter.</small>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "New password again" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <%= form.submit "Save password", class: "button" %>
<% end %>
