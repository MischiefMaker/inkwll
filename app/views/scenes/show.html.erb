<% content_for :title, "#{@scene.title} · Inkwll" %>
<%# An open Chapter's page shows its latest Passages and re-renders live
    whenever the Chapter changes (new Passages, turns, people). ?all=1 shows
    every Passage instead, on a page that doesn't update by itself, so long
    Chapters stay quick. A finished Chapter always shows everything. %>
<% whole = @scene.finished? || params[:all] == "1" %>
<%= turbo_stream_from @scene unless whole && !@scene.finished? %>

<% readable = @scene.readable_by?(current_account) %>
<article class="scene <%= chapter_layout_classes %>" data-controller="scene-reader"
         data-scene-reader-url-value="<%= scene_reading_path(@scene) %>"
         data-scene-reader-participating-value="<%= @scene.participating?(current_account) %>">
  <%# Two columns on wide screens: the story, and beside it the Place, who's
      in the Chapter and the writing tools. On narrower screens the side
      column's parts slot back in above and below the story. %>
  <div class="scene__main">
  <header class="scene__header">
    <p class="scene__kicker"><%= term(:scene) %> <%= @scene.number %></p>
    <h1 class="page-title"><%= @scene.title %></h1>
    <% if @scene.subtitle %><p class="scene__subtitle"><%= @scene.subtitle %></p><% end %>
    <p class="scene__meta muted">
      <span class="badge badge--<%= @scene.visibility %>"><%= scene_visibility_mark(@scene) %><%= scene_visibility_label(@scene) %></span>
      <% if @scene.ic_when.present? %><span class="scene__when"><%= @scene.ic_when %></span> ·<% end %>
      <%= scene_mode_summary(@scene) %>
      <%= scene_labels(@scene) %>
      <% if @scene.participating?(current_account) && @scene.writable? %>
        · <%= link_to "#{term(:scene)} settings", edit_scene_path(@scene) %>
      <% end %>
      <% if readable %>
        · <%= link_to "Report", new_scene_report_path(@scene) %>
      <% end %>
    </p>
    <%= render "scenes/cast_cards", scene: @scene if readable && chapter_cast_cards? %>
  </header>

  <%= render "scenes/status", scene: @scene, participant: @participant %>

  <% if readable %>
    <% poses = @scene.poses.includes(:soul_roll, character: [ :room, :character_group, :profile_values, { icon_attachment: :blob } ]) %>
    <% unless whole %>
      <% earlier = [ @scene.last_sequence - Scene::LIVE_PASSAGES, 0 ].max %>
      <% if earlier.positive? %>
        <% poses = poses.where(sequence: (earlier + 1)..) %>
        <p class="text passages__earlier"><%= link_to "Read the whole #{term(:scene).downcase} (#{pluralize(earlier, "earlier post")})", scene_path(@scene, all: 1) %></p>
      <% end %>
    <% end %>
    <% if whole && !@scene.finished? %>
      <p class="muted passages__whole">Showing every <%= term(:pose).downcase %>. This page doesn't update by itself. <%= link_to "Back to the live #{term(:scene).downcase}", scene_path(@scene) %></p>
    <% end %>
    <%# A finished Chapter is a Manuscript, so OOC lines are left out unless asked for. %>
    <% if @scene.finished? && @scene.poses.ooc.exists? %>
      <% if params[:ooc] == "1" %>
        <p class="muted passages__ooc-toggle">Showing OOC lines. <%= link_to "Hide them", scene_path(@scene) %></p>
      <% else %>
        <% poses = poses.where.not(kind: "ooc") %>
        <p class="muted passages__ooc-toggle"><%= link_to "Show OOC lines", scene_path(@scene, ooc: 1) %></p>
      <% end %>
    <% end %>
    <div class="passages<%= " passages--scroll" if @scene.writable? && !whole %>" id="passages" data-scene-reader-target="passages" data-controller="follow-bottom">
      <% if poses.empty? %>
        <p class="muted passages__empty">No <%= term(:pose, count: 2).downcase %> yet.</p>
      <% end %>
      <%= render partial: "poses/pose", collection: poses, locals: { scene: @scene, breaks: scene_break_ids(poses) } %>
    </div>

    <%# One pop-up mini-profile per character on the page. %>
    <% (poses.filter_map(&:character) + @scene.characters).uniq.each do |character| %>
      <%= render "characters/mini_profile", character: character %>
    <% end %>

    <% if whole && !@scene.finished? %>
      <p class="text passages__whole"><%= link_to "Back to the live #{term(:scene).downcase} to post", scene_path(@scene) %></p>
    <% elsif @scene.writable? %>
      <div class="scene__footer">
        <%= render "scenes/pending_rolls", scene: @scene, participant: @participant if Soul.enabled? %>
        <%= render "scenes/turn_bar", scene: @scene, participant: @participant %>
        <% if @participant %>
          <%= render "scenes/writing_as", scene: @scene, participant: @participant %>
          <%= render "scenes/composer", scene: @scene, participant: @participant %>
        <% else %>
          <%= render "scenes/join", scene: @scene %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="from-afar">
      <p class="muted">
        This <%= term(:scene).downcase %> is <%= scene_visibility_label(@scene).downcase %>.
        Only characters in it, or invited to it, can read it.
      </p>
      <%= render "scenes/join", scene: @scene %>
    </div>
  <% end %>
  </div>

  <aside class="scene__side">
    <%= render "scenes/setting", scene: @scene %>
    <%= render "scenes/participants", scene: @scene, participant: @participant %>
    <% if readable && @participant %>
      <%# Posting tools only where you can post; Storyteller tools also after it ends. %>
      <% posting = @scene.writable? && !whole %>
      <% story_tools = Soul.enabled? && @participant.storyteller? && (posting || !@scene.writable?) %>
      <% link_box = Inkling.enabled? && !@participant.character.gm? %>
      <% if posting || story_tools || link_box %>
        <div class="scene__tools">
          <%= render "scenes/roll", scene: @scene, participant: @participant if posting && Soul.enabled? %>
          <%= render "scenes/cast", scene: @scene, participant: @participant if posting && Grimoire.enabled? %>
          <%= render "scenes/inkling_link", scene: @scene, participant: @participant if link_box %>
          <%= render "scenes/storyteller_tools", scene: @scene, participant: @participant if story_tools %>
        </div>
      <% end %>
    <% end %>
  </aside>
</article>
