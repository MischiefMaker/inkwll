<%# Writing a Passage. Kept as-is while the page updates live (turbo
    permanent), so a half-written Passage is never lost. Its id includes the
    character, so switching characters (or the speed) gives a fresh box. %>
<div id="composer_<%= scene.id %>_<%= participant.character_id %><%= "_#{scene.speed}" if scene.speed %>" class="composer" data-turbo-permanent>
  <%= form_with url: scene_poses_path(scene), scope: :pose, class: "form",
        data: { controller: "composer draft", composer_enter_posts_value: scene.speed == "live", draft_key_value: "passage-#{scene.id}-#{participant.character_id}",
                action: "turbo:submit-end->composer#reset turbo:submit-end->draft#posted keydown->composer#shortcut submit->composer#check" } do |form| %>
    <%= hidden_field_tag :post_anyway, "0", data: { composer_target: "anyway" } %>
    <% kinds = scene.postable_kinds(participant) %>
    <fieldset class="composer__kinds">
      <legend class="visually-hidden">What to post</legend>
      <% { "passage" => term(:pose), "npc" => "NPC", "narration" => "Narration", "mutter" => "Mutter", "letter" => "Letter or text", "ooc" => "OOC" }.each do |kind, label| %>
        <% next unless kinds.include?(kind) %>
        <label class="composer__kind">
          <%= form.radio_button :kind, kind, checked: kind == "passage", data: { composer_target: "kind", action: "composer#kindChanged" } %>
          <%= label %>
        </label>
      <% end %>
    </fieldset>
    <div class="composer__npc" hidden data-composer-target="npc">
      <% if scene.may_use_npcs?(participant) && (npcs = Npc.ordered.pluck(:name, :id)).any? %>
        <%= form.label :npc_id, "The game's NPCs" %>
        <%= form.select :npc_id, npcs, { include_blank: "Someone else (type a name)" }, class: "composer__npc-pick", data: { composer_target: "npcPick", action: "composer#kindChanged" } %>
      <% end %>
      <%= form.label :npc_name, "NPC's name" %>
      <%= form.text_field :npc_name, maxlength: 60, data: { composer_target: "npcName" } %>
    </div>
    <% if kinds.include?("mutter") %>
      <div class="composer__mutter" hidden data-composer-target="mutter">
        <%= form.label :to, "Mutter to" %>
        <%= form.select :to, scene.participants.reject { |p| p.character_id == participant.character_id }.map { |p| [ p.character.name, p.character_id ] }, {}, data: { composer_target: "mutterTo" } %>
        <small class="hint">They hear all of it. Everyone else only catches a few words.</small>
      </div>
    <% end %>
    <div class="composer__letter" hidden data-composer-target="letter">
      <fieldset class="composer__letter-style">
        <legend class="visually-hidden">Letter or text</legend>
        <label class="composer__kind"><%= form.radio_button :letter_style, "letter", checked: true %> A letter</label>
        <label class="composer__kind"><%= form.radio_button :letter_style, "text" %> A text message</label>
      </fieldset>
      <%= form.label :letter_to, "To (optional)" %>
      <%= form.text_field :letter_to, maxlength: 60, placeholder: "Who it's for" %>
    </div>
    <%= form.label :body, "Write a #{term(:pose).downcase} as #{participant.character.name}", class: "composer__label",
          data: { composer_target: "label", passage: "Write a #{term(:pose).downcase} as #{participant.character.name}",
                  npc: "Write as the NPC (played by #{participant.character.name})",
                  narration: "Write narration: set the scene or describe what happens",
                  mutter: "Mutter, as #{participant.character.name}. It doesn't take a turn.",
                  letter: "Write the letter or text from #{participant.character.name}. Everyone in the #{term(:scene).downcase} can read it. It doesn't take a turn.",
                  ooc: "Out of character (brb, timing, questions). It doesn't take a turn." } %>
    <%= form.text_area :body, rows: { "live" => 2, "forum" => 10 }.fetch(scene.speed, 3), required: true, data: { composer_target: "body", draft_target: "field", action: "input->draft#save" } %>
    <div class="composer__warning" hidden data-composer-target="warning">
      <span class="composer__warning-text" data-composer-target="warningText"></span>
      <button type="button" class="button" data-action="composer#postAnyway">Post anyway</button>
      <button type="button" class="button-link" data-action="composer#cancel">Wait</button>
    </div>
    <div class="composer__actions">
      <small class="muted composer__shortcut"><%= scene.speed == "live" ? "Enter to post, Shift+Enter for a new line." : "Ctrl+Enter to post." %></small>
      <%= form.submit "Post", class: "button" %>
    </div>
  <% end %>
</div>
