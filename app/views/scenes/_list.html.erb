<%# The Chapters in a Setting, busiest first. Idle ones sink to the bottom.
    Hidden Chapters only show to the players in them or invited to them. %>
<% scenes = Scene.open.visible_to(current_account).where(room: room).by_activity.includes(participants: :character) %>
<section class="scene-list">
  <h2 class="section-title"><%= term(:scene, count: 2) %></h2>
  <% if scenes.any? %>
    <ul class="list">
      <% scenes.each do |scene| %>
        <li class="scene-list__item<%= " scene-list__item--idle" if scene.idle? %>">
          <div class="scene-list__heading">
            <%= link_to scene.title, scene_path(scene), class: "scene-list__title" %>
            <span class="badge badge--<%= scene.visibility %>"><%= scene_visibility_mark(scene) %><%= scene_visibility_label(scene) %></span>
            <% if scene.paused? %><span class="badge">Paused</span><% elsif scene.idle? %><span class="badge">Idle</span><% end %>
            <%= scene_labels(scene) %>
          </div>
          <% if scene.subtitle %><p class="scene-list__subtitle"><%= scene.subtitle %></p><% end %>
          <div class="muted scene-list__meta">
            <% if scene.ic_when.present? %><span class="scene-list__when"><%= scene.ic_when %></span> ·<% end %>
            <%= scene.participants.any? ? character_names_sentence(scene.participants, suffix: ->(p) { "(#{term(:storyteller)})" if p.storyteller? }) : "Nobody yet" %>
            · <%= time_ago_in_words(scene.last_activity_at) %> ago
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="muted">No <%= term(:scene, count: 2).downcase %> here yet.</p>
  <% end %>

  <% finished = Scene.finished.visible_to(current_account).where(room: room).count %>
  <% if finished.positive? %>
    <p class="text"><%= link_to "#{pluralize(finished, "finished #{term(:scene).downcase}")} in the #{term(:logs_collection)}", archives_path(room_id: room.id) %></p>
  <% end %>

  <% if current_character&.room_id == room.id %>
    <details class="new-scene">
      <summary class="button">Start a <%= term(:scene).downcase %> here</summary>
      <% ideas = SceneIdea.for_form %>
      <%= form_with model: Scene.new, class: "form", data: { controller: "scene-idea", scene_idea_ideas_value: ideas.to_json } do |form| %>
        <% if ideas.any? %>
          <button type="button" class="button button--quiet new-scene__idea" data-action="scene-idea#pick">Give me an idea</button>
        <% end %>
        <div class="field">
          <%= form.label :title %>
          <%= form.text_field :title, required: true, maxlength: 100, data: { scene_idea_target: "title" } %>
        </div>
        <div class="field">
          <%= form.label :subtitle, "Subtitle (optional)" %>
          <%= form.text_field :subtitle, maxlength: 150, data: { scene_idea_target: "subtitle" } %>
          <small class="hint">One line about what's happening, shown under the title.</small>
        </div>
        <% if (labels = SceneLabel.ordered).any? %>
          <fieldset class="field scene-form__labels">
            <legend class="fieldset__legend">Labels</legend>
            <%= form.collection_check_boxes :label_ids, labels, :id, :name do |box| %>
              <label class="field--checkbox scene-form__label" title="<%= box.object.description %>"><%= box.check_box %> <%= box.text %></label>
            <% end %>
          </fieldset>
        <% end %>
        <fieldset class="field scene-form__when">
          <legend class="fieldset__legend">When it happens</legend>
          <div class="form--inline">
            <%= form.label :ic_date, "Date", class: "visually-hidden" %>
            <%= form.date_field :ic_date, value: IcClock.today %>
            <%= form.label :ic_time, "Time of day", class: "visually-hidden" %>
            <%= form.text_field :ic_time, maxlength: 40, placeholder: "Time of day (optional)" %>
          </div>
          <small class="hint">Today in the game is <%= IcClock.today.to_fs(:long) %>.</small>
        </fieldset>
        <fieldset class="field">
          <legend class="fieldset__legend">Who can join</legend>
          <label class="field--checkbox"><%= form.radio_button :visibility, "joinable", checked: true %> <%= t("terms.scene_visibility.joinable") %>: anyone can watch and join.</label>
          <label class="field--checkbox"><%= form.radio_button :visibility, "private" %> <%= t("terms.scene_visibility.private") %>: others can see who's in it, but only invited characters can read or join.</label>
          <label class="field--checkbox"><%= form.radio_button :visibility, "hidden" %> <%= t("terms.scene_visibility.hidden") %>: only invited characters know it exists.</label>
        </fieldset>
        <div class="field">
          <%= form.label :pose_mode, "Turns" %>
          <%= form.select :pose_mode, Scene.pose_modes.keys.map { |mode| [ pose_mode_label(mode), mode ] } %>
          <small class="hint">The <%= pose_mode_label("three_pose") %> needs four characters; until then everyone takes turns.</small>
        </div>
        <% if current_account&.may_storytell? %>
          <label class="field--checkbox"><%= check_box_tag "scene[storyteller]", "1", false, id: "scene_storyteller" %> <%= current_character.name %> is the <%= term(:storyteller).downcase %></label>
        <% end %>
        <p class="muted">Starting as <%= current_character.name %>, in <%= room.name %>.</p>
        <%= form.submit "Start #{term(:scene).downcase}", class: "button" %>
      <% end %>
    </details>
  <% elsif current_account %>
    <p class="muted">Travel here to start a <%= term(:scene).downcase %>.</p>
  <% end %>
</section>
