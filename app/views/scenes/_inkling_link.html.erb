<%# Add this Chapter to an Inkling: a pop-up asks why, and the Inkling gets an entry with a link back. %>
<% character = participant.character %>
<% inklings = Inkling.visible_to(current_account).open.includes(:character).newest_first.select { |inkling| inkling.writable_by?(current_account) } %>
<div class="roll-box inkling-link-box" data-controller="dialog">
  <button type="button" class="button button--quiet inkling-link-box__open" data-action="dialog#open">Add to an Inkling</button>
  <dialog class="modal inkling-link-modal" data-dialog-target="box" data-action="click->dialog#backdrop">
    <%= form_with url: scene_inkling_links_path(scene), class: "form modal__form inkling-link-modal__form" do |form| %>
      <h2 class="modal__title">Add “<%= scene.title %>” to an Inkling</h2>
      <p class="hint">The Inkling gets a new entry with a link to this <%= term(:scene).downcase %>. Say why: for example, how it moved a Goal forward or set it back.</p>
      <div class="field">
        <%= form.label :inkling_id, "Inkling" %>
        <%= form.select :inkling_id, inklings.map { |inkling| [ "#{inkling.title} (#{inkling.character.name}, #{inkling.type_name})", inkling.id ] }, include_blank: "A new Inkling…" %>
      </div>
      <details class="inkling-link-modal__new">
        <summary class="disclosure__summary">Details for a new Inkling (only if you picked “A new Inkling…”)</summary>
        <div class="field"><%= form.label :kind, "Type" %>
          <%= form.select :kind, Inkling.types_for(current_account).map { |key, type| [ type["name"], key ] } %></div>
        <div class="field"><%= form.label :title, "Title" %>
          <%= form.text_field :title, maxlength: 120 %></div>
      </details>
      <div class="field">
        <%= form.label :reason, "Why is this #{term(:scene).downcase} being added?" %>
        <%= form.text_area :reason, rows: 4, required: true, maxlength: 20_000 %>
      </div>
      <div class="modal__actions">
        <%= form.submit "Add to the Inkling", class: "button" %>
        <button type="button" class="button button--quiet" data-action="dialog#close">Cancel</button>
      </div>
    <% end %>
  </dialog>
</div>
