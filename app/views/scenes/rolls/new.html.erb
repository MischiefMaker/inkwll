<% content_for :title, "Roll #{@skill.name} · Inkwll" %>
<%# Before a roll: tick which of the character's Boons and Banes apply. Ones
    that affect this Skill start ticked; the rest are there if the player
    thinks they belong in the story. %>
<h1 class="page-title">Roll <%= @skill.name %></h1>
<p class="text roll-confirm__what"><%= @character.name %> rolls <%= @skill.name %> against <%= params[:difficulty].to_s.humanize %>. Which Boons and Banes apply?</p>

<%= form_with url: scene_rolls_path(@scene), class: "form roll-confirm" do |form| %>
  <%= hidden_field_tag :skill_id, @skill.id %>
  <%= hidden_field_tag :difficulty, @difficulty %>
  <%= hidden_field_tag :confirmed, "1" %>
  <fieldset class="fieldset roll-confirm__bnbs">
    <legend class="fieldset__legend">Boons and Banes</legend>
    <% @entries.each do |entry| %>
      <label class="field--checkbox roll-confirm__bnb">
        <%= check_box_tag "bnb_ids[]", entry.id, entry.affects?(@skill), id: "bnb_#{entry.id}" %>
        <%= entry.name %> (<%= entry.level.capitalize %> <%= entry.kind.capitalize %>)<%= " — affects #{@skill.name}" if entry.affects?(@skill) %>
      </label>
    <% end %>
  </fieldset>
  <%= form.submit "Roll it", class: "button" %>
  <%= link_to "Back to the #{term(:scene).downcase}", scene_path(@scene), class: "button-link roll-confirm__back" %>
<% end %>
