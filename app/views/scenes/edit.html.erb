<% content_for :title, "#{term(:scene)} settings · Inkwll" %>

<h1 class="page-title"><%= @scene.title %>: settings</h1>

<%= form_with model: @scene, class: "form" do |form| %>
  <%= render "shared/errors", record: @scene %>
  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, maxlength: 100 %>
  </div>
  <fieldset class="field">
    <legend class="fieldset__legend">Who can join</legend>
    <% locked_hidden = @scene.visibility_was == "hidden" && @scene.made_public_at.nil? %>
    <% Scene.visibilities.each_key do |visibility| %>
      <label class="field--checkbox"><%= form.radio_button :visibility, visibility, disabled: locked_hidden && visibility != "hidden" %> <%= t("terms.scene_visibility.#{visibility}") %></label>
    <% end %>
    <% if locked_hidden %>
      <small class="hint">A Hidden <%= term(:scene).downcase %> only opens up when every player agrees, below.</small>
    <% end %>
  </fieldset>
  <div class="field">
    <%= form.label :pose_mode, "Turns" %>
    <%= form.select :pose_mode, Scene.pose_modes.keys.map { |mode| [ pose_mode_label(mode), mode ] } %>
  </div>
  <div class="field field--checkbox">
    <%= form.check_box :auto_skip %>
    <%= form.label :auto_skip, "Auto-skip players who don't take their turn" %>
  </div>
  <div class="field">
    <%= form.label :turn_minutes, "Minutes before the warning" %>
    <%= form.number_field :turn_minutes, min: 1, max: 120 %>
    <small class="hint">After the warning, the player has <%= Scene::Turns::WARNING_MINUTES %> more minutes to click "I'm here!".</small>
  </div>
  <div class="form--inline">
    <%= form.submit "Save", class: "button" %>
    <%= link_to "Cancel", scene_path(@scene) %>
  </div>
<% end %>

<% if @scene.visibility_hidden? && @scene.made_public_at.nil? %>
  <section class="scene-consent">
    <h2 class="section-title">Making it public</h2>
    <p class="text">This <%= term(:scene).downcase %> stays hidden unless every player agrees to make it public.
      Agreed so far: <%= @scene.participants.count(&:public_consent_at) %> of <%= @scene.participants.size %>.</p>
    <% participant = @scene.participant_for(current_character) %>
    <% if participant&.public_consent_at %>
      <%= button_to "Take back my agreement", scene_public_consent_path(@scene), method: :delete, class: "button-link" %>
    <% elsif participant %>
      <%= button_to "I agree to make it public", scene_public_consent_path(@scene), class: "button button--quiet" %>
    <% end %>
  </section>
<% end %>
