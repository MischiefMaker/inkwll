<% content_for :title, "#{term(:scene)} settings · Inkwll" %>

<h1 class="page-title"><%= @scene.title %>: settings</h1>

<%= form_with model: @scene, class: "form" do |form| %>
  <%= render "shared/errors", record: @scene %>
  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true, maxlength: 100 %>
  </div>
  <div class="field">
    <%= form.label :subtitle, "Subtitle (optional)" %>
    <%= form.text_field :subtitle, maxlength: 150 %>
    <small class="hint">One line about what's happening, shown under the title.</small>
  </div>
  <% if (labels = SceneLabel.ordered).any? %>
    <fieldset class="field scene-form__labels">
      <legend class="fieldset__legend">Labels</legend>
      <%= form.collection_check_boxes :label_ids, labels, :id, :name do |box| %>
        <label class="field--checkbox scene-form__label" title="<%= box.object.description %>"><%= box.check_box %> <%= box.text %></label>
      <% end %>
    </fieldset>
  <% end %>
  <fieldset class="field scene-form__when">
    <legend class="fieldset__legend">When it happens</legend>
    <div class="form--inline">
      <%= form.label :ic_date, "Date", class: "visually-hidden" %>
      <%= form.date_field :ic_date %>
      <%= form.label :ic_time, "Time of day", class: "visually-hidden" %>
      <%= form.text_field :ic_time, maxlength: 40, placeholder: "Time of day (optional)" %>
    </div>
    <small class="hint">The game's date was <%= IcClock.today.to_fs(:long) %> when this <%= term(:scene).downcase %> started or since. Changing it adds a line to the <%= term(:scene).downcase %> so everyone sees.</small>
  </fieldset>
  <fieldset class="field">
    <legend class="fieldset__legend">Who can join</legend>
    <% Scene.visibilities.each_key do |visibility| %>
      <label class="field--checkbox"><%= form.radio_button :visibility, visibility, disabled: !@scene.may_switch_to?(visibility, from: @scene.visibility_was) %> <%= t("terms.scene_visibility.#{visibility}") %></label>
    <% end %>
    <% if @scene.made_public_at.nil? && @scene.visibility_was != "joinable" %>
      <small class="hint">A <%= t("terms.scene_visibility.#{@scene.visibility_was}") %> <%= term(:scene).downcase %> only opens up when every player agrees, below.</small>
    <% end %>
  </fieldset>
  <%= scene_speed_fieldset(form) %>
  <div class="field">
    <%= form.label :pose_mode, "Turns" %>
    <%= form.select :pose_mode, Scene.pose_modes.keys.map { |mode| [ pose_mode_label(mode), mode ] } %>
  </div>
  <div class="field field--checkbox">
    <%= form.check_box :auto_skip %>
    <%= form.label :auto_skip, "Auto-skip players who don't take their turn" %>
  </div>
  <div class="field">
    <%= form.label :turn_minutes, "Minutes before the warning" %>
    <%= form.number_field :turn_minutes, min: 1, max: 120 %>
    <small class="hint">After the warning, the player has <%= Scene::Turns::WARNING_MINUTES %> more minutes to click "I'm here!".</small>
  </div>
  <div class="form--inline">
    <%= form.submit "Save", class: "button" %>
    <%= link_to "Cancel", scene_path(@scene) %>
  </div>
<% end %>

<% if @scene.closed_to_others? && @scene.made_public_at.nil? %>
  <section class="scene-consent">
    <h2 class="section-title">Making it public</h2>
    <p class="text">This <%= term(:scene).downcase %> stays <%= t("terms.scene_visibility.#{@scene.visibility}").downcase %> unless every player agrees to make it public.
      Agreed so far: <%= @scene.participants.count(&:public_consent_at) %> of <%= @scene.participants.size %>.</p>
    <% participant = @scene.participant_for(current_character) %>
    <% if participant&.public_consent_at %>
      <%= button_to "Take back my agreement", scene_public_consent_path(@scene), method: :delete, class: "button-link" %>
    <% elsif participant %>
      <%= button_to "I agree to make it public", scene_public_consent_path(@scene), class: "button button--quiet" %>
    <% end %>
  </section>
<% end %>
