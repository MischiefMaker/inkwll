<%# Kept in place while moving between pages, so the chat never reloads. %>
<%# Guests get a different id, so the chat box is rebuilt after they log in instead of still saying "Chatting as (guest)". %>
<aside id="<%= current_account ? "ooc-sidebar" : "ooc-sidebar-guest" %>" class="ooc-sidebar" data-turbo-permanent data-controller="collapsible-sidebar">
  <button type="button" class="ooc-sidebar__toggle" aria-controls="ooc-sidebar-body" aria-expanded="true"
          title="Hide OOC Chat" data-collapsible-sidebar-target="toggle" data-action="collapsible-sidebar#toggle">
    <span class="ooc-sidebar__arrow" aria-hidden="true">›</span>
    <span class="ooc-sidebar__tab-label">OOC Chat</span>
    <span class="ooc-sidebar__count" data-collapsible-sidebar-target="count" hidden></span>
  </button>
  <div id="ooc-sidebar-body" class="ooc-sidebar__body" data-controller="chat-tabs">
    <h2 class="ooc-sidebar__title">OOC Chat</h2>
    <%= render "private_chats/panel", account: current_account if current_account %>
    <div class="chat-pane chat-pane--ooc" data-chat-tabs-target="pane" data-pane="ooc">
      <%= render "ooc_messages/chat" %>
    </div>
  </div>
</aside>
