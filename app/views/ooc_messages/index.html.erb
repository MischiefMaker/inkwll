<% content_for :title, "OOC Chat · Inkwll" %>
<% content_for :hide_ooc_sidebar, true %>

<h1>OOC Chat</h1>
<% if current_account %>
  <p class="muted">Out-of-character chat for everyone on the site. Messages show your player name, not a character name.</p>
<% else %>
  <p class="muted">Out-of-character chat for everyone on the site. Ask anything here as a guest. Guests can't post links.
    To make a character, <%= link_to "create an account", new_registration_path %> or <%= link_to "log in", new_session_path %>.</p>
<% end %>

<div class="ooc-page">
  <%= render "ooc_messages/chat" %>
</div>
