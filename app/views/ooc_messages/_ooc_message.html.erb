<%# Everyone gets the same message (it's broadcast live), so the Edit, Delete
    and Block controls are always there but hidden; the page shows them to
    the author and to staff (see "ooc_messages/own_controls"). %>
<div class="ooc-message<%= " ooc-message--deleted" if ooc_message.deleted? %>" id="<%= dom_id ooc_message %>">
  <%= player_icon(ooc_message) %>
  <% if ooc_message.guest? %>
    <span class="ooc-message__author ooc-message__author--guest"><%= ooc_message.author_name %></span>
  <% else %>
    <%= link_to ooc_message.author_name, player_path(ooc_message.account.username), class: "ooc-message__author" %><%= new_player_badge(ooc_message.account) %>
  <% end %>
  <time class="ooc-message__time" datetime="<%= ooc_message.created_at.iso8601 %>"><%= ooc_message.created_at.utc.strftime("%H:%M") %></time>
  <% if ooc_message.deleted? %>
    <em class="ooc-message__body ooc-message__body--deleted"><%= ooc_message.removed_by_staff? ? "Removed by staff" : "Deleted" %></em>
  <% else %>
    <span class="ooc-message__body"><%= ooc_message.body %></span>
    <% if ooc_message.edited_at %>
      <span class="ooc-message__edited"><%= ooc_message.edited_by_staff? ? "(edited by staff)" : "(edited)" %></span>
    <% end %>
    <span class="ooc-message__actions" data-author="<%= ooc_message.account_id %>">
      <%# Pencil, trashcan and no-entry icons, drawn like the header's bell. %>
      <%= link_to edit_ooc_message_path(ooc_message), class: "ooc-message__action ooc-message__edit", title: "Edit" do %>
        <svg class="ooc-message__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.17 6.81a1 1 0 0 0-3.99-3.99L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5z"/><path d="m15 5 4 4"/></svg><span class="visually-hidden">Edit</span>
      <% end %>
      <%= button_to ooc_message_path(ooc_message), method: :delete, class: "button-link ooc-message__action ooc-message__delete", title: "Delete",
            form_class: "ooc-message__delete-form", form: { data: { turbo_confirm: "Delete this message?" } } do %>
        <svg class="ooc-message__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><path d="M10 11v6"/><path d="M14 11v6"/></svg><span class="visually-hidden">Delete</span>
      <% end %>
      <%= link_to new_admin_ban_path(ooc_message_id: ooc_message.id), class: "ooc-message__action ooc-message__block", title: "Block from the OOC Chat" do %>
        <svg class="ooc-message__icon" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m4.9 4.9 14.2 14.2"/></svg><span class="visually-hidden">Block</span>
      <% end %>
    </span>
  <% end %>
</div>
