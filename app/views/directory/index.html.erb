<% content_for :title, "#{@roster_only ? "Roster" : "Character directory"} · Inkwll" %>

<div class="directory">
  <h1 class="page-title"><%= @roster_only ? "Roster" : "Character directory" %></h1>
  <p class="text muted directory__intro">
    <% if @roster_only %>
      Characters waiting for someone to play them. Open one to apply.
    <% else %>
      Everyone being played, and the characters on the roster.
    <% end %>
  </p>

  <%= form_with url: (@roster_only ? roster_path : directory_path), method: :get, class: "form form--inline directory__filter" do |form| %>
    <% if @fields.any? %>
      <%= form.label :field, "Filter by", class: "visually-hidden" %>
      <%= form.select :field, @fields.map { |field| [ field.name, field.id ] }, { include_blank: "Any field", selected: @field&.id }, class: "directory__field" %>
      <%= form.label :value, "Containing", class: "visually-hidden" %>
      <%= form.search_field :value, value: @value, placeholder: "Containing…", maxlength: 100, class: "directory__value" %>
    <% end %>
    <% if @groups.any? %>
      <%= form.label :group, "Group", class: "visually-hidden" %>
      <%= form.select :group, @groups.map { |group| [ group.name, group.id ] }, { include_blank: "Any group", selected: @group&.id }, class: "directory__group-filter" %>
    <% end %>
    <label class="field--checkbox directory__roster-only"><%= check_box_tag :roster, "1", @roster_only %> Roster only</label>
    <%= form.submit "Filter", name: nil, class: "button button--quiet" %>
  <% end %>

  <% if @characters.any? %>
    <ul class="directory__list">
      <% @characters.each do |character| %>
        <li class="directory__item<%= " directory__item--roster" if character.on_roster? %>">
          <%= link_to character_path(character), class: "directory__link" do %>
            <%= character_icon(character, size: :large) %>
            <%= tag.span character.name, **character_name_options(character, "directory__name") %>
          <% end %>
          <% if character.character_group %><span class="directory__group muted"><%= character.character_group.name %></span><% end %>
          <% if character.on_roster? %><span class="tag directory__tag">On the roster</span><% end %>
          <% if (value = @values[character.id]) %><span class="directory__value-shown muted"><%= @field.name %>: <%= value.value.truncate(80) %></span><% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text muted">Nobody matches.</p>
  <% end %>
</div>
