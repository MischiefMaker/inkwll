<%# The player's open Chapters as tabs, each showing its Setting, an unread
    count and whether it's their turn. Reloads live (see chapter_tabs/_frame). %>
<% participations = SceneParticipant.joins(:scene).where(character: account.characters)
     .where(tab_closed: false).where("scenes.finished_at IS NULL OR scenes.finished_at > ?", Scene::UNDO_FINISH_WITHIN.ago)
     .includes(:character, scene: :room).merge(Scene.by_activity) %>
<% several_characters = participations.map(&:character_id).uniq.size > 1 %>
<% unread_total = 0 %>
<% turns_waiting = participations.count { |participant| !participant.scene.finished? && !participant.scene.paused? && participant.scene.turn_of?(participant) } %>
<turbo-frame id="chapter_tabs">
  <% if participations.any? %>
    <nav class="chapter-tabs" aria-label="Your <%= term(:scene, count: 2).downcase %>"
         data-controller="chapter-tabs unread-title browser-notify"
         data-browser-notify-level-value="<%= account.browser_notifications %>"
         data-browser-notify-minutes-value="<%= account.browser_notify_minutes %>">
      <button type="button" class="chapter-tabs__toggle" data-action="chapter-tabs#toggle" data-chapter-tabs-target="toggle" aria-expanded="true">
        <span class="chapter-tabs__toggle-open"><%= icon(:chevron_down, size: 14, css: "chapter-tabs__arrow") %> <%= term(:scene, count: 2) %> (<%= participations.size %>)</span>
        <span class="chapter-tabs__toggle-closed" title="Show your <%= term(:scene, count: 2).downcase %>">+ (<%= participations.size %>)</span>
        <% if turns_waiting.positive? %>
          <span class="chapter-tabs__turn-flag" title="<%= pluralize(turns_waiting, "#{term(:scene).downcase}") %> waiting for you"><%= icon(:quill, size: 16) %></span>
        <% end %>
      </button>
      <div class="chapter-tabs__list">
      <% participations.each do |participant| %>
        <% scene = participant.scene %>
        <% unread = participant.unread_count %>
        <% unread_total += unread %>
        <div class="chapter-tab-wrap">
        <%= link_to scene_path(scene), class: "chapter-tab", data: { turbo_frame: "_top", chapter_tabs_target: "tab", browser_notify_target: "tab", scene_id: scene.id,
              title: scene.title, unread_count: unread, sequence: scene.last_sequence, turn: scene.turn_of?(participant) ? scene.turn_token : nil,
              waiting_since: (account.browser_notifications == "after_minutes" && unread.positive?) ? participant.unread_passages.minimum(:created_at)&.iso8601 : nil } do %>
          <span class="chapter-tab__title"><%= scene.title %></span>
          <span class="chapter-tab__setting">
            <%= scene.room.name %><%= " · #{participant.character.name}" if several_characters %>
          </span>
          <% if scene.finished? %>
            <span class="chapter-tab__turn">Finished</span>
          <% elsif scene.paused? %>
            <span class="chapter-tab__turn">Paused</span>
          <% elsif scene.turn_of?(participant) %>
            <span class="chapter-tab__turn">Your turn</span>
          <% end %>
          <% your_turn = !scene.finished? && !scene.paused? && scene.turn_of?(participant) %>
          <% if your_turn || unread.positive? %>
            <span class="chapter-tab__badges">
              <% if your_turn %><span class="chapter-tab__quill" title="Your turn"><%= icon(:quill, size: 16) %></span><% end %>
              <% if unread.positive? %>
                <span class="chapter-tab__unread" data-unread="<%= unread %>" title="<%= pluralize(unread, "new #{term(:pose).downcase}") %>"><%= unread %></span>
              <% end %>
            </span>
          <% end %>
        <% end %>
        <% if scene.finished? %>
          <%= button_to close_chapter_tab_path(participant), method: :delete, class: "chapter-tab__close", form_class: "chapter-tab__close-form", title: "Close this tab", "aria-label": "Close the tab for #{scene.title}" do %><%= icon(:close, size: 12) %><% end %>
        <% end %>
        </div>
      <% end %>
      </div>
      <span hidden data-unread-title-target="total" data-total="<%= unread_total %>"></span>
    </nav>
  <% end %>
</turbo-frame>
