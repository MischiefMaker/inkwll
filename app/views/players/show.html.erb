<% content_for :title, "#{@player.display_name} · Inkwll" %>

<article class="player-profile">
  <header class="player-profile__header">
    <%= player_avatar(@player, size: :large) %>
    <div class="player-profile__heading">
      <h1 class="page-title player-profile__name"><%= @player.display_name %></h1>
      <p class="muted player-profile__kind">Player<%= " · #{t("terms.staff_levels.#{@player.staff_level}")}" if @player.staff? %></p>
      <div class="player-profile__actions">
        <% if @player == current_account %>
          <%= link_to "Edit my profile", edit_player_profile_path, class: "button button--quiet" %>
        <% else %>
          <%= link_to "Send a message", new_conversation_path(to: @player.display_name), class: "button button--quiet" %>
        <% end %>
      </div>
    </div>
  </header>

  <section class="player-profile__about">
    <h2 class="section-title">About me</h2>
    <% if @player.about_me.present? %>
      <div class="prose"><%= simple_format @player.about_me %></div>
    <% else %>
      <p class="muted">Nothing here yet.</p>
    <% end %>
  </section>

  <% if @show_characters %>
    <section class="player-profile__characters">
      <h2 class="section-title">Characters</h2>
      <% characters = @player.characters.order(:name).select { |c| c.approved? || @player == current_account || current_account.staff? } %>
      <% if characters.any? %>
        <ul class="player-characters">
          <% characters.each do |character| %>
            <li class="player-characters__item">
              <%= character_icon(character, size: :small) %>
              <%= link_to character.name, character, class: "player-characters__name" %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="muted">No characters yet.</p>
      <% end %>
      <% unless GameSetting.current.players_public? %>
        <p class="muted player-profile__private-note">Only you and staff can see this list.</p>
      <% end %>
    </section>
  <% end %>
</article>
