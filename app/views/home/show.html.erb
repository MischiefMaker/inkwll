<% content_for :title, "Inkwll" %>

<% settings = GameSetting.current %>
<p class="game-time">
  <span class="game-time__date">It is <%= IcClock.today.to_fs(:long) %>.</span>
  <% if settings.weather %><span class="game-time__weather"><%= settings.weather %></span><% end %>
</p>

<% if current_character %>
  <p class="where-now">
    <%= current_character.name %> is in
    <%= link_to current_character.room.name, room_path(current_character.room) %>.
  </p>
<% else %>
  <p class="where-now">
    <%= link_to "Create a character", new_character_path %> to start playing.
  </p>
<% end %>

<% if @areas.any? %>
  <%= render partial: "home/category", collection: @areas, as: :area %>
<% else %>
  <p class="muted">No <%= term(:area, count: 2).downcase %> yet.</p>
<% end %>

<section class="online-now">
  <h2 class="section-title">Online now</h2>
  <% if @online.any? %>
    <p class="text online-now__list"><%= safe_join(@online.map { |character| character_name_link(character) }, ", ") %>
      · <%= link_to "Where everyone is", where_path %></p>
  <% else %>
    <p class="text muted">Nobody else is around right now.</p>
  <% end %>
</section>
