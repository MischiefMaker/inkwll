<% content_for :title, "Inkwll" %>

<% settings = GameSetting.current %>
<header class="game-intro">
  <h1 class="game-intro__name"><%= game_icon(:large) %><span class="game-intro__title"><%= game_name %></span></h1>
  <% if settings.game_blurb %>
    <div class="game-intro__blurb"><%= simple_format settings.game_blurb %></div>
  <% end %>
</header>

<div class="game-status">
  <p class="game-time">
    <span class="game-time__date">It is <%= IcClock.today.to_fs(:long) %>.</span>
    <% if settings.weather %><span class="game-time__weather"><%= settings.weather %></span><% end %>
  </p>

  <% if current_character %>
    <p class="where-now">
      <%= character_icon(current_character, size: :tiny) %>
      <%= tag.span current_character.name, **character_name_options(current_character, "where-now__name") %> is in
      <%= link_to current_character.room.name, room_path(current_character.room) %>.
      <%= turn_quill(current_character.room_id) %>
    </p>
  <% elsif !current_account %>
    <p class="where-now where-now--guest">
      Previewing as a guest. <%= link_to "Log in", new_session_path %> or <%= link_to "sign up", new_registration_path %> to play.
    </p>
  <% else %>
    <p class="where-now">
      <%= link_to "Create a character", new_character_path %> to start playing.
    </p>
  <% end %>
</div>

<% if @areas.any? %>
  <section class="places">
    <%= render partial: "home/place", collection: @areas, as: :area %>
  </section>
<% else %>
  <p class="muted">No <%= term(:area, count: 2).downcase %> yet.</p>
<% end %>

<%= render "home/after_places" %>

<section class="online-now">
  <div class="online-now__head">
    <h2 class="section-title online-now__title">Online now <span class="online-now__count">(<%= @online.size %>)</span></h2>
    <%= link_to where_path, class: "online-now__where" do %><%= icon(:pin, size: 16, css: "online-now__where-icon") %>See where everyone is<% end %>
  </div>
  <% if @online.any? %>
    <%# Players, not characters. Who they're playing shows only when the game
        makes players public, or to staff, so it never gives away an alt. %>
    <% show_playing = GameSetting.current.players_public? || current_account&.staff? %>
    <ul class="online-now__list">
      <% @online.each do |player| %>
        <% playing = player.active_character if show_playing && player.active_character && !player.active_character.gm? && !player.active_character.retired? %>
        <li class="online-now__player">
          <%= link_to player_path(player.username), class: "online-now__link" do %>
            <%= player_avatar(player, size: :small) %>
            <span class="online-now__name"><%= player.display_name %></span>
          <% end %>
          <% if playing %>
            <%= tag.span playing.name, **character_name_options(playing, "online-now__playing") %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="text muted">Nobody else is around right now.</p>
  <% end %>
</section>

<%# Counts only, like a forum's footer. See PublicStats for what is left out. %>
<% stats = PublicStats.counts %>
<section class="game-stats" aria-label="Game statistics">
  <%# Players have no public list (it would give away who plays whom), so only staff who manage players get a link. %>
  <% [ [ :players, "Players", :profile, (admin_accounts_path if current_account&.can?(:manage_staff)) ],
       [ :characters, "Characters", :characters, directory_path ],
       [ :chapters, term(:scene, count: 2), :quill, where_path ],
       [ :archives, term(:logs_collection), :archive, archives_path ] ].each do |kind, label, icon_name, path| %>
    <span class="game-stats__item game-stats__item--<%= kind %>">
      <%= icon(icon_name, size: 16, css: "game-stats__icon") %>
      <% if path %>
        <%= link_to label, path, class: "game-stats__label game-stats__link" %>
      <% else %>
        <span class="game-stats__label"><%= label %></span>
      <% end %>
      <span class="game-stats__count"><%= number_with_delimiter(stats[kind]) %></span>
    </span>
  <% end %>
</section>
