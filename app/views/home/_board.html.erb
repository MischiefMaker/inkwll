<%# One Area as a board: image, name (opens its entrance Setting),
    description, and the ▾ shortcuts to every Setting inside it. %>
<% entrance = area.entrance %>
<% target = entrance ? room_path(entrance) : area_path(area) %>
<article class="board-row">
  <% if area.image.attached? %>
    <%= link_to image_tag(area.image, alt: "", class: "board-row__image"), target %>
  <% end %>
  <div class="board-row__body">
    <h3 class="board-row__title">
      <%= link_to area.name, target %>
      <% shortcuts = area.all_rooms %>
      <% if shortcuts.size > 1 %>
        <details class="shortcuts">
          <summary aria-label="Shortcuts in <%= area.name %>"></summary>
          <div class="shortcuts__items">
            <%= link_to "Overview of #{area.name}", area_path(area), class: "muted" %>
            <% shortcuts.each do |room| %>
              <%= link_to room.name, room_path(room) %>
            <% end %>
          </div>
        </details>
      <% end %>
    </h3>
    <% if area.description.present? %>
      <p class="board-row__description"><%= area.description %></p>
    <% end %>
  </div>
  <div class="board-row__activity muted">
    <% here = Character.where(room_id: area.all_rooms.select(:id)).count %>
    <%= here.zero? ? "Quiet" : pluralize(here, "character") + " here" %>
  </div>
</article>
