<%# One post in a Chapter: a Passage, an NPC's Passage, narration, an OOC
    line, or a line from the game such as "Wren joins the Chapter."
    Clicking a character's icon or name opens their mini-profile. %>
<% if local_assigns[:breaks]&.include?(pose.id) %>
  <p class="pose-break" aria-hidden="true">✦ ✦ ✦</p>
<% end %>
<% if pose.system? %>
  <p class="pose pose--system" id="<%= dom_id pose %>" data-sequence="<%= pose.sequence %>"><%= pose.body %></p>
<% else %>
  <% character = pose.character %>
  <% mine = character && own?(character) %>
  <%# Forum, and Manuscript with large portraits, put the picture, name and
      details in an author panel beside the text instead of the header. %>
  <% panel = passage_author_panel? && (pose.passage? || pose.npc?) %>
  <article class="pose pose--<%= pose.kind %><%= " pose--with-author" if panel %><%= " pose--mine" if mine %><%= " pose--removed" if pose.removed? %><%= " pose--retired" if character&.retired? %>" id="<%= dom_id pose %>" data-sequence="<%= pose.sequence %>">
    <% icon_size = panel ? :portrait : :small %>
    <% icon = capture do %>
      <% if pose.npc? %>
        <span class="pose__icon"><%= tag.span pose.npc_name.first.upcase, class: "character-icon character-icon--#{icon_size} character-icon--initial character-icon--npc", aria: { hidden: true } %></span>
      <% elsif pose.passage? && character %>
        <button type="button" class="pose__icon" popovertarget="mini-profile-<%= character.id %>" aria-label="About <%= character.name %>">
          <%= character_icon(character, size: icon_size) %>
        </button>
      <% elsif pose.passage? %>
        <span class="pose__icon"><%= character_icon(nil, size: icon_size) %></span>
      <% end %>
    <% end %>
    <% name = capture do %>
      <% if pose.npc? %>
        <span class="pose__name"><%= pose.npc_name %></span>
        <span class="pose__played-by muted">NPC, played by
          <% if character %><button type="button" class="button-link" popovertarget="mini-profile-<%= character.id %>"><%= character.name %></button><% else %>a departed character<% end %></span>
      <% elsif character && pose.passage? %>
        <%= tag.button character.name, type: "button", popovertarget: "mini-profile-#{character.id}", **character_name_options(character, "pose__name") %>
        <%= character_details(character, "pose__details muted") %>
      <% elsif character %>
        <%= tag.button character.name, type: "button", popovertarget: "mini-profile-#{character.id}", **character_name_options(character, "pose__name pose__name--small") %>
      <% else %>
        <span class="pose__name muted">A departed character</span>
      <% end %>
    <% end %>
    <% if panel %>
      <div class="pose__author"><%= icon %><%= name %></div>
    <% else %>
      <%= icon %>
    <% end %>
    <div class="pose__main">
      <header class="pose__header">
        <% if pose.ooc? %>
          <span class="pose__tag">OOC</span>
        <% elsif pose.narration? %>
          <span class="pose__tag">Narration</span>
        <% elsif pose.roll? %>
          <span class="pose__tag">Roll</span>
        <% elsif pose.letter? %>
          <span class="pose__tag pose__tag--letter"><%= pose.letter_style == "text" ? "Text" : "Letter" %></span>
        <% elsif pose.mutter? %>
          <span class="pose__tag pose__tag--mutter">Mutter</span>
        <% end %>
        <%= name unless panel %>
        <time class="pose__time muted" datetime="<%= pose.created_at.iso8601 %>" title="<%= pose.created_at.utc.to_fs(:long) %> UTC"><%= time_ago_in_words(pose.created_at) %> ago</time>
        <% if pose.edited? && !pose.removed? %><span class="pose__edited muted">(edited)</span><% end %>
        <% if mine && !pose.removed? && !pose.roll? && scene.writable? %>
          <span class="pose__actions">
            <%= edit_icon_link(edit_scene_pose_path(scene, pose)) %>
            <%= delete_icon_button(scene_pose_path(scene, pose), label: "Remove", confirm: "Remove this #{term(:pose).downcase}?") %>
          </span>
        <% end %>
      </header>
      <% staff_view = scene.reported_to?(current_account) %>
      <% if pose.hidden_by_staff? && !staff_view %>
        <p class="muted pose__body">Hidden by staff.</p>
      <% elsif pose.removed? && !staff_view %>
        <p class="muted pose__body"><%= term(:pose) %> removed.</p>
      <% else %>
        <% if staff_view && (pose.hidden_by_staff? || pose.removed?) %>
          <p class="pose__staff-note"><%= visibility_mark(:staff_only) %> <%= pose.hidden_by_staff? ? "Hidden by staff" : "Removed by its player" %> (only staff see this text)</p>
        <% end %>
        <% if pose.mutter? %>
          <% heard = staff_view || pose.full_for?(current_account) %>
          <p class="pose__mutter-to muted"><%= pose.character&.name %> mutters to <%= pose.to_characters.map(&:name).to_sentence %><%= heard ? ". Only they hear all of it; everyone else catches a few words." : ", and you catch a few words." %></p>
          <div class="pose__body prose<%= " pose__body--overheard" unless heard %>"><%= simple_format(heard ? pose.body : pose.overheard_body) %></div>
        <% elsif pose.letter? %>
          <div class="pose__letter pose__letter--<%= pose.letter_style %>">
            <% if pose.letter_to %><p class="pose__letter-to"><%= pose.letter_style == "text" ? "To: " : "To " %><%= pose.letter_to %><%= "," if pose.letter_style == "letter" %></p><% end %>
            <div class="pose__body prose"><%= simple_format pose.body %></div>
            <% if pose.letter_style == "letter" %><p class="pose__letter-from"><%= pose.character&.name %></p><% end %>
          </div>
        <% else %>
          <div class="pose__body prose"><%= simple_format pose.body %></div>
        <% end %>
        <% if pose.roll? && (roll = pose.soul_roll) %>
          <details class="pose__roll roll-details">
            <summary class="disclosure__summary roll-details__summary">How it was rolled</summary>
            <p class="text roll-details__text">Dice: <%= roll.dice_text %>. <%= roll.skill_name %> <%= roll.skill_rating %>, plus <%= roll.aspect_bonus %> from its Aspect. Total <%= roll.result %> against <%= roll.difficulty %>. The chance of this outcome was <%= number_to_percentage(roll.probability.to_f * 100, precision: 1, strip_insignificant_zeros: true) %>.</p>
          </details>
        <% end %>
        <% if staff_view && pose.original_body %>
          <details class="pose__original"><summary class="disclosure__summary"><%= visibility_mark(:staff_only) %> Original, before editing (staff only)</summary><div class="prose"><%= simple_format pose.original_body %></div></details>
        <% end %>
      <% end %>
      <% if staff_view && !pose.hidden_by_staff? %>
        <%= button_to "Hide (staff)", admin_pose_hiding_path(pose), class: "button-link pose__staff-action",
              form: { data: { turbo_confirm: "Hide this #{term(:pose).downcase} from players? The text is kept." } } %>
      <% elsif !mine %>
        <%= link_to "Report", new_scene_report_path(scene, pose_id: pose.id), class: "pose__report" %>
      <% end %>
    </div>
  </article>
<% end %>
