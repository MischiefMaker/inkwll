<%# The character's application status, shown to their player and staff. %>
<% unless character.approved? %>
  <div class="notice-box application-status application-status--<%= character.status %>">
    <% case character.status %>
    <% when "draft", "returned" %>
      <% if character.returned? %>
        <p class="text"><strong class="emphasis">Returned by staff.</strong><%= " Note: #{character.review_note}" if character.review_note %></p>
      <% else %>
        <p class="text"><strong class="emphasis">Not submitted yet.</strong> <%= character.name %> can explore, but can't join <%= term(:scene, count: 2).downcase %> until staff approve them.</p>
      <% end %>
      <% if own?(character) %>
        <% missing = character.missing_for_submission %>
        <% if missing.any? %>
          <p class="text application-status__missing">Still needed: <%= missing.to_sentence %>. <%= link_to "Edit", edit_character_path(character) %></p>
        <% else %>
          <%= button_to "Submit for approval", character_submission_path(character), class: "button" %>
        <% end %>
      <% end %>
    <% when "submitted" %>
      <p class="text"><strong class="emphasis">Waiting for staff.</strong> Submitted <%= time_ago_in_words(character.submitted_at) %> ago.</p>
    <% end %>
    <% if current_account&.can?(:review_apps) && character.submitted? %>
      <p class="text"><%= link_to "Review this application", admin_application_path(character) %></p>
    <% end %>
  </div>
<% end %>
