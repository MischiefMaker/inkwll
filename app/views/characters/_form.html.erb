<%= form_with model: character, class: "form character-form" do |form| %>
  <%= render "shared/errors", record: character %>

  <fieldset class="fieldset character-form__basics">
    <legend class="fieldset__legend">Basics</legend>
    <div class="field">
      <%= form.label :name %>
      <% if character.new_record? || character.renamable_by?(current_account) %>
        <%= form.text_field :name, required: true, autofocus: true %>
        <% unless character.new_record? || current_account.staff? %><small class="hint">You can rename <%= character.name %> until staff approve them. Staff keep a log of name changes.</small><% end %>
      <% else %>
        <p class="text"><%= character.name %> <span class="muted">(approved, so only staff can rename them)</span></p>
      <% end %>
    </div>
    <div class="field">
      <%= form.label :icon %>
      <% if character.icon.attached? %>
        <%= character_icon(character, size: :large) %>
        <label class="field--checkbox"><%= form.check_box :remove_icon %> Remove this icon</label>
      <% end %>
      <%= form.file_field :icon, accept: "image/png,image/jpeg,image/gif,image/webp" %>
      <small class="hint">Shown beside every <%= term(:pose).downcase %>. A square picture works best. PNG, JPEG, GIF or WebP, up to 5 MB.<%= " Needed before you submit." if GameSetting.current.require_icon? %></small>
    </div>
    <% groups = CharacterGroup.ordered %>
    <% if groups.any? %>
      <div class="field character-form__group">
        <%= form.label :character_group_id, "Group" %>
        <% if character.new_record? || character.group_choosable? %>
          <%= form.select :character_group_id, groups.map { |group| [ group.name, group.id ] }, include_blank: "None" %>
          <small class="hint">Colours <%= character.name.presence || "their" %><%= "'s" if character.name.present? %> name. Once approved, only staff can change it.</small>
        <% else %>
          <p class="text"><%= character.character_group&.name || "None" %> <span class="muted">(ask staff to change it)</span></p>
        <% end %>
      </div>
    <% end %>
    <% if Faction.enabled? && (factions = Faction.pickable.ordered).any? %>
      <div class="field character-form__factions">
        <% if character.new_record? || character.group_choosable? %>
          <fieldset class="character-form__faction-choices">
            <legend class="character-form__faction-legend"><%= term(:faction, count: 2) %></legend>
            <%= hidden_field_tag "character[picked_faction_ids][]", "", id: nil %>
            <% chosen = character.faction_memberships.map(&:faction_id) %>
            <% factions.each do |faction| %>
              <label class="field--checkbox character-form__faction">
                <%= check_box_tag "character[picked_faction_ids][]", faction.id, chosen.include?(faction.id), id: "character_faction_#{faction.id}" %>
                <%= faction.name %>
              </label>
            <% end %>
            <small class="hint">Families, guilds and clubs. Pick as many as fit. Once approved, a <%= term(:faction).downcase %>'s heads or staff add them to more.</small>
          </fieldset>
        <% else %>
          <p class="text"><span class="character-form__faction-legend"><%= term(:faction, count: 2) %>:</span> <%= character.factions.ordered.map(&:name).to_sentence.presence || "None" %> <span class="muted">(heads and staff add members from each <%= term(:faction).downcase %>'s page)</span></p>
        <% end %>
      </div>
    <% end %>
  </fieldset>

  <% { "demographics" => "Demographics", "application" => "Application" }.each do |section, heading| %>
    <% fields = ProfileField.in_section(section) %>
    <% next if fields.empty? %>
    <fieldset class="fieldset character-form__<%= section %>">
      <legend class="fieldset__legend"><%= heading %></legend>
      <% fields.each do |field| %>
        <% profile_value = character.profile_value_for(field) %>
        <% value = profile_value&.value %>
        <div class="field character-form__field character-form__field--<%= field.field_type %>">
          <%= label_tag "character_profile_#{field.id}" do %><%= field.name + (field.required? ? " *" : "") %><%= visibility_mark(:locked, label: "Locked once approved") if field.locked_for?(character, current_account) %><% end %>
          <% if field.locked_for?(character, current_account) %>
            <% if field.image? && profile_value&.image&.attached? %>
              <%= image_tag profile_value.image, class: "profile-field-input__picture", alt: "" %>
            <% else %>
              <div class="text character-form__locked-value"><%= simple_format(value.presence || "Nothing yet") %></div>
            <% end %>
            <small class="hint">Locked once approved. Ask staff to change it.</small>
          <% else %>
          <%= render "shared/profile_field_input", field: field, value: value, name: "character[profile][#{field.id}]", id: "character_profile_#{field.id}", picture: profile_value&.image %>
          <small class="hint"><%= field.hint %><%= " PNG, JPEG, GIF or WebP, up to 5 MB." if field.image? %><%= " Only you and staff can see this." unless field.public? %></small>
          <% end %>
        </div>
      <% end %>
    </fieldset>
  <% end %>

  <fieldset class="fieldset character-form__roster">
    <legend class="fieldset__legend">If you stop playing</legend>
    <label class="field--checkbox character-form__roster-when-idle">
      <%= form.check_box :roster_when_idle %> Put <%= character.name.presence || "this character" %> on the roster for someone else to play if they go idle
    </label>
    <small class="hint">After <%= GameSetting.current.roster_idle_days %> days without posting or moving, another player can apply to take them over. They get everything in character, but none of your Messages.</small>
  </fieldset>

  <%= form.submit class: "button" %>
<% end %>
