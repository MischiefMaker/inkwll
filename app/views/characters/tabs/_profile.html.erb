<%# Short facts (age, birthday...) sit in the box at the top or side; long answers and pictures show here. %>
<% long_answers = render("characters/profile_fields", character: character, section: "demographics", show_private: show_private, facts: false) %>
<% if long_answers.present? %>
  <%= long_answers %>
<% else %>
  <p class="muted profile-tab__empty">Nothing more to show here.</p>
<% end %>
