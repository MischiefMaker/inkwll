<% content_for :title, "#{@character.name} · Inkwll" %>
<% show_private = @mine || @staff_view %>

<% box_side = GameSetting.current.profile_box == "side" %>
<article class="character-profile character-profile--box-<%= box_side ? "side" : "top" %> character-profile--<%= @character.status %><%= " character-profile--retired" if @character.retired? %><%= " character-profile--on-roster" if @character.on_roster? %>">
  <header class="character-profile__header profile-box profile-box--<%= box_side ? "side" : "top" %>">
    <div class="profile-box__portrait"><%= character_icon(@character, size: :large) %></div>
    <div class="character-profile__heading profile-box__heading">
      <%= tag.h1 @character.name, **character_name_options(@character, "page-title character-profile__name") %>
      <% if @character.character_group %><p class="character-profile__group"><%= link_to @character.character_group.name, group_path(@character.character_group) %><% if @character.group_rank %> <span class="character-profile__rank muted"><%= @character.group_rank %></span><% end %></p><% end %>
      <% if Faction.enabled? && (memberships = @character.visible_faction_memberships_for(current_account)).any? %>
        <ul class="character-profile__factions">
          <% memberships.each do |membership| %>
            <li class="character-profile__faction<%= " character-profile__faction--secret" if membership.secret? || membership.faction.secret? %>"><%= link_to membership.faction.name, faction_path(membership.faction) %><%= ", #{membership.title}" if membership.title %><%= " (head)" if membership.head? %><%= visibility_mark(:you_and_staff, label: "Secret") if membership.secret? || membership.faction.secret? %></li>
          <% end %>
        </ul>
      <% end %>
      <%= looking_for_rp_mark(@character) %>
      <% if @character.deceased? %>
        <p class="character-profile__deceased muted">Died <%= @character.deceased_on.strftime("%-d %B %Y") %>.<% if @character.deceased_note %> <span class="character-profile__epitaph"><%= @character.deceased_note %></span><% end %> <%= link_to "Graveyard", graveyard_path %></p>
      <% elsif @character.retired? && !@character.roster_kept? %><p class="character-profile__retired muted">Retired. <%= @character.name %> is no longer played.</p><% end %>
      <p class="character-profile__where muted">Currently in <%= link_to @character.room.name, room_path(@character.room) %>.</p>
      <%= render "characters/profile_box_facts", character: @character, show_private: show_private %>
      <% if @mine && @character.can_play? %>
        <details class="character-profile__looking-for-rp"<%= " open" if @character.looking_for_rp? %>>
          <summary>Looking for RP</summary>
          <%= render "characters/looking_for_rp_form", character: @character %>
        </details>
      <% end %>
      <div class="character-profile__actions profile-box__actions">
        <% if @mine %>
          <%= edit_icon_link(edit_character_path(@character)) %>
          <% if Inkling.enabled? && @character.approved? && !@character.retired? %>
            <%= link_to "Start an Inkling", new_inkling_path(character_id: @character.id), class: "button button--quiet character-profile__inkling" %>
          <% end %>
          <% unless @character.retired? || @character.roster_requested? %>
            <%= button_to "Ask staff to put on the roster", character_roster_request_path(@character), class: "button button--quiet character-profile__roster-request",
                  form: { data: { turbo_confirm: "Ask staff to give #{@character.name} up for someone else to play? If they agree, #{@character.name} stops being yours." } } %>
          <% end %>
        <% elsif !@character.on_roster? %>
          <% if Inkling.enabled? && current_account&.can?(:review_apps) && @character.approved? && !@character.retired? %>
            <%= link_to "Start an Inkling for #{@character.name}", new_inkling_path(character_id: @character.id), class: "button button--quiet character-profile__inkling" %>
          <% end %>
          <%= link_to "Message the player of #{@character.name}", new_conversation_path(character_id: @character.id), class: "button button--quiet" %>
        <% end %>
      </div>
    </div>
  </header>

  <% if @mine || @staff_view %>
    <%= render "characters/application_status", character: @character %>
  <% end %>
  <%= render "characters/roster_status", character: @character %>

  <%# A menu down the left with a heading per section (Basics, System, Writing), and the chosen page beside it. %>
  <% system_pages = {}
     system_pages["soul"] = "SOUL" if Soul.enabled? && show_private
     system_pages["inklings"] = "Inklings" if Inkling.enabled? && show_private
     system_pages["grimoire"] = "Grimoire" if Grimoire.enabled? && show_private
     system_pages["purse"] = term(:purse) if Economy.enabled? && show_private
     system_pages["belongings"] = term(:belongings) if Crafting.items_enabled?
     writing_pages = { "logs" => term(:log, count: 2) }
     writing_pages["chapters"] = "Active #{term(:scene, count: 2)}" if @mine || @staff_view
     sections = { "basics" => [ "Basics", { "profile" => "Profile", "application" => "Application", "relationships" => "Relationships", "gallery" => "Image Gallery" } ],
                  "system" => [ "System", system_pages ], "writing" => [ "Writing", writing_pages ] } %>
  <div class="profile-layout">
    <nav class="profile-menu" aria-label="Profile sections">
      <% sections.each do |key, (heading, pages)| %>
        <% next if pages.empty? %>
        <div class="profile-menu__group profile-menu__group--<%= key %>">
          <h2 class="profile-menu__heading"><%= heading %><%= visibility_mark(:you_and_staff) if key == "system" %></h2>
          <ul class="profile-menu__list">
            <% pages.each do |page, label| %>
              <li class="profile-menu__item">
                <%= link_to character_path(@character, tab: page), class: "profile-menu__link#{" profile-menu__link--current" if @tab == page}",
                      aria: { current: (@tab == page ? "page" : nil) } do %><%= label %><%= visibility_mark(:you_and_staff) if page == "chapters" %><% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    </nav>

    <section class="character-profile__panel character-profile__panel--<%= @tab %>">
      <%= render "characters/tabs/#{@tab}", character: @character, show_private: show_private %>
    </section>
  </div>
</article>
