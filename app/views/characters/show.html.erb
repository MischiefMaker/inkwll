<% content_for :title, "#{@character.name} · Inkwll" %>

<h1 class="character-heading"><%= character_icon(@character, size: :large) %> <%= @character.name %></h1>

<p class="muted">Currently in <%= link_to @character.room.name, room_path(@character.room) %>.</p>

<% if @character.description.present? %>
  <div class="prose"><%= simple_format @character.description %></div>
<% end %>

<% manuscripts = Scene.finished.visible_to(current_account).where(id: @character.scene_participants.select(:scene_id)).includes(:room, participants: :character).order(finished_at: :desc).limit(20) %>
<% if manuscripts.any? %>
  <section>
    <h2><%= term(:log, count: 2) %></h2>
    <%= render partial: "archives/manuscript", collection: manuscripts, as: :scene %>
    <p><%= link_to "All of #{@character.name}'s #{term(:log, count: 2).downcase}", archives_path(character_id: @character.id) %></p>
  </section>
<% end %>

<% if @character.account == current_account %>
  <p><%= link_to "Edit", edit_character_path(@character) %></p>
<% end %>
