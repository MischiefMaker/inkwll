<% content_for :title, "#{@character.name} · Inkwll" %>
<% show_private = @mine || @staff_view %>

<article class="character-profile character-profile--<%= @character.status %><%= " character-profile--retired" if @character.retired? %>">
  <header class="character-profile__header">
    <%= character_icon(@character, size: :large) %>
    <div class="character-profile__heading">
      <h1 class="page-title character-profile__name"><%= @character.name %></h1>
      <% if @character.retired? %><p class="character-profile__retired muted">Retired. <%= @character.name %> is no longer played.</p><% end %>
      <p class="character-profile__where muted">Currently in <%= link_to @character.room.name, room_path(@character.room) %>.</p>
      <div class="character-profile__actions">
        <% if @mine %>
          <%= link_to "Edit", edit_character_path(@character), class: "button button--quiet" %>
        <% else %>
          <%= link_to "Message the player of #{@character.name}", new_conversation_path(character_id: @character.id), class: "button button--quiet" %>
        <% end %>
      </div>
    </div>
  </header>

  <% if @mine || @staff_view %>
    <%= render "characters/application_status", character: @character %>
  <% end %>

  <nav class="profile-tabs" aria-label="Profile sections">
    <% tabs = { "profile" => "Profile", "application" => "Application" } %>
    <% tabs["soul"] = "SOUL" if Soul.enabled? && show_private %>
    <% tabs.merge!("gallery" => "Gallery", "relationships" => "Relationships", "logs" => term(:log, count: 2)) %>
    <% tabs.each do |tab, label| %>
      <%= link_to label, character_path(@character, tab: tab), class: "profile-tabs__tab#{" profile-tabs__tab--current" if @tab == tab}",
            aria: { current: (@tab == tab ? "page" : nil) } %>
    <% end %>
  </nav>

  <section class="character-profile__panel character-profile__panel--<%= @tab %>">
    <%= render "characters/tabs/#{@tab}", character: @character, show_private: show_private %>
  </section>
</article>
