<%# The filled-in fields of one section, as a list of name and value. %>
<% rows = ProfileField.in_section(section).filter_map do |field|
     next unless field.public? || show_private
     long = field.field_type.in?(%w[ long_text image ])
     next if local_assigns[:facts] == true && long
     next if local_assigns[:facts] == false && !long
     value = character.profile_value_for(field)
     [ field, value ] if value&.value.present?
   end %>
<% if rows.any? || local_assigns[:extra] %>
  <dl class="details-list profile-fields profile-fields--<%= section %>">
    <%= local_assigns[:extra] %>
    <% rows.each do |field, value| %>
      <div class="profile-fields__row profile-fields__row--<%= field.field_type %>">
        <dt class="details-list__term"><%= field.name %><%= tag.span(visibility_mark(:you_and_staff), class: "profile-fields__private") unless field.public? %></dt>
        <dd class="details-list__value">
          <% if field.image? %>
            <%= image_tag value.image, class: "profile-fields__picture", alt: "#{character.name}: #{field.name}" if value.image.attached? %>
          <% elsif field.date? && (date = value.as_date) %>
            <%= date.to_fs(:long) %>
          <% elsif field.field_type == "long_text" %>
            <div class="prose"><%= simple_format value.value %></div>
          <% else %>
            <%= value.value %>
          <% end %>
        </dd>
      </div>
    <% end %>
  </dl>
<% end %>
