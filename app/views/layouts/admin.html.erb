<%# Admin panel pages: the normal page, with the admin tabs above the content. %>
<% content_for :admin_content do %>
  <nav class="admin-tabs" aria-label="Admin panel">
    <%= link_to "Overview", admin_root_path, class: ("is-current" if controller_name == "dashboard") %>
    <% if current_account.can?(:build) %>
      <%= link_to "Building", admin_areas_path, class: ("is-current" if controller_name.in?(%w[ areas rooms exits ])) %>
    <% end %>
    <% if current_account.can?(:manage_staff) %>
      <%= link_to "Players and staff", admin_accounts_path, class: ("is-current" if controller_name == "accounts") %>
    <% end %>
    <% if current_account.can?(:review_apps) %>
      <% waiting = Character.submitted.count %>
      <%= link_to "Applications#{" (#{waiting})" if waiting.positive?}", admin_applications_path, class: ("is-current" if controller_name == "applications") %>
      <% roster_waiting = RosterApplication.pending.count + Character.active.where.not(roster_requested_at: nil).count %>
      <%= link_to "Roster#{" (#{roster_waiting})" if roster_waiting.positive?}", admin_roster_path, class: ("is-current" if controller_name.in?(%w[ roster roster_applications roster_characters ])) %>
      <% if Soul.enabled? %>
        <% soul_waiting = Soul::BnbRequest.pending.count + Soul::Culmination.proposed.count %>
        <%= link_to "SOUL requests#{" (#{soul_waiting})" if soul_waiting.positive?}", admin_soul_reviews_path, class: ("is-current" if controller_name == "soul_reviews") %>
        <%= link_to "Boons and Banes", admin_soul_bnbs_path, class: ("is-current" if controller_name == "soul_bnbs") %>
      <% end %>
    <% end %>
    <% if current_account.can?(:handle_reports) %>
      <% open_reports = Report.unresolved.count %>
      <%= link_to "Reports#{" (#{open_reports})" if open_reports.positive?}", admin_reports_path, class: ("is-current" if controller_name.in?(%w[ reports warnings ])) %>
    <% end %>
    <% if current_account.can?(:ban) %>
      <%= link_to "Bans", admin_bans_path, class: ("is-current" if controller_name == "bans") %>
    <% end %>
    <% if current_account.can?(:delete_characters) %>
      <%= link_to "Characters", admin_characters_path, class: ("is-current" if controller_name == "characters") %>
    <% end %>
    <% if current_account.can?(:change_game_settings) %>
      <%= link_to "Profile fields", admin_profile_fields_path, class: ("is-current" if controller_name == "profile_fields") %>
      <%= link_to "SOUL", admin_soul_path, class: ("is-current" if controller_name.in?(%w[ soul soul_aspects soul_skills ])) %>
      <%= link_to "Game settings", edit_admin_game_settings_path, class: ("is-current" if controller_name == "game_settings") %>
    <% end %>
  </nav>
  <%= yield %>
<% end %>
<%= render template: "layouts/application" %>
