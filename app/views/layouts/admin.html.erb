<%# Admin panel pages: the normal page, with the admin menu down the right-hand side. %>
<% content_for :admin_menu do %>
  <% groups = admin_menu_groups %>
  <% current = (groups.flat_map(&:last) + [ admin_menu_overview ]).find(&:current) %>
  <%# Open on wide screens; on phones it folds into one button at the top (see admin_menu_controller.js). %>
  <details class="admin-menu" open data-controller="admin-menu">
    <summary class="admin-menu__button">
      Admin menu<% if current %>: <span class="admin-menu__button-current"><%= current.label %></span><% end %>
    </summary>
    <nav class="admin-menu__body" aria-label="Admin panel">
      <h2 class="admin-menu__title">Admin panel</h2>
      <%= link_to admin_menu_overview.label, admin_menu_overview.path, class: [ "admin-menu__link", "admin-menu__link--overview", ("is-current" if admin_menu_overview.current) ], aria: { current: ("page" if admin_menu_overview.current) } %>
      <% groups.each do |heading, links| %>
        <section class="admin-menu__group">
          <h3 class="admin-menu__heading"><%= heading %></h3>
          <ul class="admin-menu__list">
            <% links.each do |link| %>
              <li class="admin-menu__item">
                <%= link_to link.path, class: [ "admin-menu__link", ("is-current" if link.current) ], aria: { current: ("page" if link.current) } do %>
                  <span class="admin-menu__label"><%= link.label %></span>
                  <% if link.waiting.positive? %><span class="admin-menu__count" title="Waiting"><%= link.waiting %></span><% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </section>
      <% end %>
    </nav>
  </details>
<% end %>
<% content_for :admin_content do %>
  <%= yield %>
<% end %>
<%= render template: "layouts/application" %>
