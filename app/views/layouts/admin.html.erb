<%# Admin panel pages: the normal page, with the admin tabs above the content. %>
<% content_for :admin_content do %>
  <nav class="admin-tabs" aria-label="Admin panel">
    <%= link_to "Overview", admin_root_path, class: ("is-current" if controller_name == "dashboard") %>
    <% if current_account.can?(:build) %>
      <%= link_to "Building", admin_areas_path, class: ("is-current" if controller_name.in?(%w[ areas rooms exits ])) %>
    <% end %>
    <% if current_account.can?(:manage_staff) %>
      <%= link_to "Players and staff", admin_accounts_path, class: ("is-current" if controller_name == "accounts") %>
    <% end %>
    <% if current_account.can?(:delete_characters) %>
      <%= link_to "Characters", admin_characters_path, class: ("is-current" if controller_name == "characters") %>
    <% end %>
    <% if current_account.can?(:change_game_settings) %>
      <%= link_to "Game settings", edit_admin_game_settings_path, class: ("is-current" if controller_name == "game_settings") %>
    <% end %>
  </nav>
  <%= yield %>
<% end %>
<%= render template: "layouts/application" %>
