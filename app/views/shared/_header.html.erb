<header class="site-header">
  <%= link_to root_path, class: "site-header__title" do %><%= game_icon(:small) %><span class="site-header__name"><%= game_name %></span><% end %>

  <nav class="site-header__nav">
    <%= link_to root_path, class: "site-header__link site-header__home" do %><%= icon(:home, css: "site-header__icon") %><span class="site-header__label">Home</span><% end %>
    <%= link_to characters_path, class: "site-header__link site-header__characters" do %><%= icon(:characters, css: "site-header__icon") %><span class="site-header__label">My Characters</span><% end %>
    <%= render "conversations/count", account: current_account %>
    <%# The bell opens the latest alerts in a small drop-down over the page. %>
    <details class="alert-menu" data-controller="alert-menu" data-action="toggle->alert-menu#toggle click@document->alert-menu#closeOutside">
      <summary class="alert-menu__summary"><%= render "alerts/count", account: current_account %></summary>
      <div class="alert-menu__panel">
        <turbo-frame id="alerts_panel" target="_top" class="alert-menu__frame" data-alert-menu-target="frame" data-src="<%= alerts_path %>">
          <p class="text muted">Loading…</p>
        </turbo-frame>
      </div>
    </details>
    <%# Extras live in the menu so the roleplay stays front and centre. %>
    <details class="menu">
      <summary class="disclosure__summary"><%= icon(:menu, css: "site-header__icon") %><span class="site-header__label">Menu</span></summary>
      <div class="menu__items">
        <p class="menu__heading menu__heading--mine">Mine</p>
        <%= link_to characters_path, class: "menu__link" do %><%= icon(:characters, size: 16, css: "menu__icon") %>My Characters<% end %>
        <%= link_to my_chapters_path, class: "menu__link" do %><%= icon(:quill, size: 16, css: "menu__icon") %>My <%= term(:scene, count: 2) %><% end %>
        <%= link_to saved_places_path, class: "menu__link" do %><%= icon(:bookmark, size: 16, css: "menu__icon") %>My Places<% end %>
        <% if Inkling.enabled? %><%= link_to inklings_path, class: "menu__link" do %><%= icon(:inkwell, size: 16, css: "menu__icon") %>My Inklings<% end %><% end %>
        <%= link_to player_path(current_account.username), class: "menu__link" do %><%= icon(:profile, size: 16, css: "menu__icon") %>My Profile<% end %>
        <%= link_to edit_notification_settings_path, class: "menu__link" do %><%= icon(:bell, size: 16, css: "menu__icon") %>Notifications<% end %>

        <p class="menu__heading menu__heading--world">The world</p>
        <%= link_to rooms_path, class: "menu__link" do %><%= icon(:door, size: 16, css: "menu__icon") %>All <%= term(:room, count: 2) %><% end %>
        <%= link_to scenes_path, class: "menu__link" do %><%= icon(:quill, size: 16, css: "menu__icon") %>Open <%= term(:scene, count: 2) %><% end %>
        <%= link_to where_path, class: "menu__link" do %><%= icon(:pin, size: 16, css: "menu__icon") %>Where<% end %>
        <%= link_to looking_for_rp_path, class: "menu__link" do %><%= icon(:quill, size: 16, css: "menu__icon") %>Looking for RP<% end %>
        <% if current_account.may_storytell? %><%= link_to storyteller_wanted_path, class: "menu__link menu__storyteller-wanted" do %><%= icon(:quill, size: 16, css: "menu__icon") %><%= term(:storyteller) %> wanted<% if (wanted = Scene.storyteller_wanted.count).positive? %> <span class="badge menu__count"><%= wanted %></span><% end %><% end %><% end %>
        <%= link_to directory_path, class: "menu__link" do %><%= icon(:characters, size: 16, css: "menu__icon") %>Character Directory<% end %>
        <%= link_to roster_path, class: "menu__link" do %><%= icon(:roster, size: 16, css: "menu__icon") %>Roster<% end %>
        <% if Character.deceased.exists? %><%= link_to graveyard_path, class: "menu__link" do %><%= icon(:archive, size: 16, css: "menu__icon") %>Graveyard<% end %><% end %>
        <% if ProfileField.exists?(field_type: "birthday") %><%= link_to birthdays_path, class: "menu__link" do %><%= icon(:star, size: 16, css: "menu__icon") %>Birthdays<% end %><% end %>
        <% if Faction.enabled? %><%= link_to factions_path, class: "menu__link" do %><%= icon(:banner, size: 16, css: "menu__icon") %><%= term(:faction, count: 2) %><% end %><% end %>
        <% if Domain.enabled? %><%= link_to domains_path, class: "menu__link" do %><%= icon(:compass, size: 16, css: "menu__icon") %><%= term(:domain, count: 2) %><% end %><% end %>
        <% if Crafting.enabled? %><%= link_to market_path, class: "menu__link" do %><%= icon(:banner, size: 16, css: "menu__icon") %><%= term(:market) %><% end %><% end %>
        <%= link_to archives_path, class: "menu__link" do %><%= icon(:bookshelf, size: 16, css: "menu__icon") %><%= term(:logs_collection) %><% end %>

        <p class="menu__heading menu__heading--community">Community and help</p>
        <%= link_to getting_started_path, class: "menu__link menu__guide" do %><%= icon(:guide, size: 16, css: "menu__icon") %>Getting Started<% end %>
        <%= link_to forum_boards_path, class: "menu__link" do %><%= icon(:board, size: 16, css: "menu__icon") %><%= term(:forum_board, count: 2) %><% end %>
        <% if WikiPage.enabled? %>
          <%= link_to wiki_pages_path, class: "menu__link" do %><%= icon(:wiki, size: 16, css: "menu__icon") %>Wiki<% end %>
          <% WikiPage.in_menu.each do |page| %>
            <%= link_to wiki_page_path(page), class: "menu__wiki-page" do %><span class="menu__wiki-dot" aria-hidden="true"></span><%= page.title %><% end %>
          <% end %>
        <% end %>
        <%= link_to ooc_messages_path, class: "menu__link" do %><%= icon(:chat, size: 16, css: "menu__icon") %>OOC Chat<% end %>
        <% if current_account.staff? %>
          <p class="menu__heading menu__heading--staff">Staff</p>
          <%= link_to admin_root_path, class: "menu__link" do %><%= icon(:shield, size: 16, css: "menu__icon") %>Admin Panel<% end %>
        <% end %>
      </div>
    </details>
  </nav>

  <div class="site-header__account">
    <% characters = current_account.characters.active.order(:name) %>
    <% gm_option = current_account.may_storytell? %>
    <% if characters.any? || gm_option %>
      <%# A custom drop-down rather than a <select>, so each character shows
          their icon and Group colour. Each entry is a button that sends its
          character's id. %>
      <%= form_with url: active_character_path, method: :patch, class: "switcher" do |form| %>
        <span class="switcher__label">Playing as</span>
        <details class="switcher__menu" data-controller="menu-dismiss" data-action="click@document->menu-dismiss#closeOutside">
          <summary class="switcher__current">
            <% if current_character&.gm? %>
              <%= icon(:quill, size: 16, css: "switcher__icon") %><span class="switcher__name">GM</span>
            <% elsif current_character %>
              <%= character_icon(current_character, size: :tiny) %><%= tag.span current_character.name, **character_name_options(current_character, "switcher__name") %>
            <% else %>
              <span class="switcher__name switcher__name--nobody">Nobody</span>
            <% end %>
          </summary>
          <div class="switcher__options">
            <% characters.each do |character| %>
              <%= button_tag type: "submit", name: "character_id", value: character.id, class: "switcher__option#{" switcher__option--current" if character.id == current_character&.id}" do %>
                <%= character_icon(character, size: :tiny) %><%= tag.span character.name, **character_name_options(character, "switcher__name") %>
              <% end %>
            <% end %>
            <% if gm_option %>
              <%= button_tag type: "submit", name: "character_id", value: "gm", class: "switcher__option switcher__gm#{" switcher__option--current" if current_character&.gm?}" do %>
                <%= icon(:quill, size: 16, css: "switcher__icon") %><span class="switcher__name">GM (<%= current_account.display_name %>)</span>
              <% end %>
            <% end %>
          </div>
        </details>
      <% end %>
    <% end %>

    <%= link_to current_account.display_name, player_path(current_account.username), class: "site-header__player", title: "Your player profile" %>
    <%= button_to "Log out", session_path, method: :delete, class: "button-link site-header__log-out" %>
  </div>
</header>
