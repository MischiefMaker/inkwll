<% content_for :title, "Create an account · Inkwll" %>

<h1 class="page-title">Create an account</h1>

<%= form_with model: @account, url: registration_path, class: "form" do |form| %>
  <%= render "shared/errors", record: @account %>

  <div class="field">
    <%= form.label :display_name, "Player name" %>
    <%= form.text_field :display_name, required: true, autofocus: true, autocomplete: "username" %>
    <small class="hint">You log in with this, and it's shown in the OOC Chat. Not a character name. Letters, numbers and underscores.</small>
  </div>
  <div class="field">
    <%= form.label :email %>
    <%= form.email_field :email, required: GameSetting.current.email_required?, autocomplete: "email" %>
    <small class="hint">Used for password resets.<%= " Optional, but without one only staff can reset your password." unless GameSetting.current.email_required? %></small>
  </div>
  <div class="field">
    <div class="field field--checkbox">
      <%= form.check_box :email_notifications, {}, "when_away", "off" %>
      <%= form.label :email_notifications, "Email me about new activity in my Chapters while I'm not logged in" %>
    </div>
    <small class="hint">Needs an email address. You can change how often, or turn it off, later.</small>
  </div>
  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 10, maxlength: 72 %>
    <small class="hint">At least 10 characters, with a number, a capital and a lower-case letter. A short sentence is easy to remember and hard to guess.</small>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Password again" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <%= form.submit "Create account", class: "button" %>
<% end %>

<p class="text">Already have an account? <%= link_to "Log in", new_session_path %>.</p>
