<% content_for :title, "Create an account · Inkwll" %>

<h1>Create an account</h1>

<%= form_with model: @account, url: registration_path, class: "form" do |form| %>
  <%= render "shared/errors", record: @account %>

  <div class="field">
    <%= form.label :username %>
    <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username" %>
    <small>Used to log in. Letters, numbers and underscores.</small>
  </div>
  <div class="field">
    <%= form.label :display_name, "Player name" %>
    <%= form.text_field :display_name, required: true %>
    <small>Shown in the OOC chat. Not a character name.</small>
  </div>
  <div class="field">
    <%= form.label :password %>
    <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <div class="field">
    <%= form.label :password_confirmation, "Password again" %>
    <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72 %>
  </div>
  <%= form.submit "Create account", class: "button" %>
<% end %>

<p>Already have an account? <%= link_to "Log in", new_session_path %>.</p>
