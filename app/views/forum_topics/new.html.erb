<% content_for :title, "Start a #{term(:forum_topic).downcase} · #{@board.name} · Inkwll" %>

<p class="breadcrumbs"><%= link_to term(:forum_board, count: 2), forum_boards_path %> › <%= link_to @board.name, forum_board_path(@board) %></p>
<h1 class="page-title">Start a <%= term(:forum_topic).downcase %></h1>

<%= form_with model: @topic, url: forum_board_forum_topics_path(@board), class: "form forum-topic-form", data: { controller: "draft", draft_key_value: "topic-#{@board.id}", action: "turbo:submit-end->draft#posted" } do |form| %>
  <%= render "shared/errors", record: @topic %>
  <%= render "shared/errors", record: @post %>
  <%= render "forum_topics/form_fields", form: form %>
  <div class="field">
    <%= form.label :body, "Message" %>
    <%= form.text_area :body, value: @post.body, rows: 10, required: true, maxlength: 20_000, data: { draft_target: "field", action: "input->draft#save" } %>
    <small class="hint">Markdown works here, as on the wiki: **bold**, *italic*, [links](https://example.com) and lists.<%= " It's posted under your player name." unless @board.in_character? %></small>
  </div>
  <%= render "forum_topics/post_as", form: form, board: @board %>
  <%= form.submit "Post #{term(:forum_topic).downcase}", class: "button" %>
<% end %>
