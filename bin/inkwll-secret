#!/usr/bin/env sh
# Prints one of the game's secrets for Kamal (see .kamal/secrets): from the
# environment when it's set (GitHub Actions), otherwise from the deploy
# folder in the project files. Usage: bin/inkwll-secret SECRET_KEY_BASE
name="$1"
value=$(printenv "$name")
if [ -z "$value" ]; then
  file="${INKWLL_SECRETS:-/mnt/project-files/deploy/secrets.env}"
  [ -f "$file" ] && value=$(grep "^$name=" "$file" | cut -d= -f2-)
fi
printf '%s' "$value"
