# Where Kamal gets the game's secrets. Never put a real password here.
# bin/inkwll-secret reads them from GitHub's secrets when deploying from
# GitHub Actions, or from the deploy folder in the project files.
# See docs/deploying.md.
SECRET_KEY_BASE=$(bin/inkwll-secret SECRET_KEY_BASE)
INKWLL_DATABASE_PASSWORD=$(bin/inkwll-secret DATABASE_PASSWORD)
POSTGRES_PASSWORD=$(bin/inkwll-secret DATABASE_PASSWORD)
WELLS_GITHUB_TOKEN=$(bin/inkwll-secret WELLS_GITHUB_TOKEN)
