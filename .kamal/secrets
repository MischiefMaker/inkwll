# Kamal reads the game's secrets from the deploy folder in the project files,
# which is never in git. See docs/deploying.md. Never put a real password here.
INKWLL_SECRETS=${INKWLL_SECRETS:-/mnt/project-files/deploy/secrets.env}

SECRET_KEY_BASE=$(grep '^SECRET_KEY_BASE=' "$INKWLL_SECRETS" | cut -d= -f2-)
INKWLL_DATABASE_PASSWORD=$(grep '^DATABASE_PASSWORD=' "$INKWLL_SECRETS" | cut -d= -f2-)
POSTGRES_PASSWORD=$(grep '^DATABASE_PASSWORD=' "$INKWLL_SECRETS" | cut -d= -f2-)
